---
import '../styles/global.css';

export const GITHUB_URL = 'https://github.com/rupulsafaya/canaryone';
export const TWITTER_URL = 'https://twitter.com/CanaryOneOSS';
export const TWITTER_HANDLE = '@CanaryOneOSS';
export const SITE_URL = 'https://canaryone.ai';

interface Props {
  title: string;
  description: string;
  /** Path this page canonicalises to, leading slash. */
  path?: string;
}

const { title, description, path = '/' } = Astro.props;
const canonical = `${SITE_URL}${path}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- All three are generated from brand/c1-logo-mark.svg by scripts/build-logo.mjs. The
         SVG wins wherever it is supported and the PNG is the fallback. -->
    <!-- The nav's lockup sits on the dark band on every page, so it is the first thing
         painted and a missing wordmark is very visible against near-black. Preloaded so it
         lands with the first paint rather than a beat after it. -->
    <link rel="preload" as="image" type="image/svg+xml" href="/c1-logo-dark.svg" />
    <!-- Declaration order is deliberate and the `sizes` hints are load-bearing.
         The .ico comes first carrying an explicit `sizes="32x32"`, which is what stops a
         browser preferring it over the vector for the tab: given a size hint it can satisfy
         from the SVG instead, it takes the SVG, and the .ico is left to serve the surfaces
         that ask for /favicon.ico by path and ignore this markup entirely — Safari's
         Favorites and bookmarks, browser history lists, and most link unfurlers. That file
         did not exist before and those requests 404'd, which is why the icon appeared in
         the tab but nowhere else. The 64px PNG stays as a last resort for anything that
         reads neither format. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE_URL}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}/og.png`} />

    <meta name="theme-color" content="#0f0f10" />
  </head>
  <body>
    <nav class="topnav">
      <div class="container inner">
        <!-- The dark-surface lockup. The light one has its wordmark at #0f0f10, which is
             exactly the nav's background, so it would render as a yellow mark and nothing
             else. Both are generated by scripts/build-logo.mjs from one export. -->
        <a class="wordmark" href="/" aria-label="CanaryOne home">
          <img src="/c1-logo-dark.svg" alt="CanaryOne" width="153" height="28" />
        </a>
        <div class="links">
          <a href="/evals"><span>Evals</span></a>
          <a href="/market">
            <span>Model Market</span>
          </a>
          <!-- Icon-only in the nav. `aria-label` carries the accessible name that the
               removed <span> used to provide, and `title` gives a sighted reader the same
               name on hover. The footer keeps its text labels — it has the room, and it is
               where the destinations get spelled out. -->
          <a class="icon-only" href={GITHUB_URL} target="_blank" rel="noopener" aria-label="CanaryOne on GitHub" title="CanaryOne on GitHub">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-2c-3.19.69-3.86-1.35-3.86-1.35-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.74.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.73.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.35.78 1.05.78 2.12v3.14c0 .3.21.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
          </a>
          <a class="icon-only" href={TWITTER_URL} target="_blank" rel="noopener" aria-label={`${TWITTER_HANDLE} on X (formerly Twitter)`} title={`${TWITTER_HANDLE} on X`}>
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.153h7.594l5.243 6.932L18.9 1.153zm-1.291 19.502h2.039L6.486 3.239H4.298L17.61 20.655z"/></svg>
          </a>
        </div>
      </div>
    </nav>

    <slot />

    <footer class="footer">
      <div class="container inner">
        <a class="footer-logo" href="/" aria-label="CanaryOne home">
          <img src="/c1-logo.svg" alt="CanaryOne" width="109" height="20" />
        </a>
        <span class="spacer"></span>
        <a href="/evals">evals</a>
        <a href="/market">model market</a>
        <!-- Icon-only, same as the nav. `aria-label` carries the accessible name the removed
             <span> used to provide, and `title` gives a sighted reader the same name on
             hover. Both share the .icon-only component with the nav. -->
        <a class="icon-only" href={GITHUB_URL} target="_blank" rel="noopener" aria-label="CanaryOne on GitHub" title="CanaryOne on GitHub">
          <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-2c-3.19.69-3.86-1.35-3.86-1.35-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.74.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.73.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.35.78 1.05.78 2.12v3.14c0 .3.21.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
        </a>
        <a class="icon-only" href={TWITTER_URL} target="_blank" rel="noopener" aria-label={`${TWITTER_HANDLE} on X (formerly Twitter)`} title={`${TWITTER_HANDLE} on X`}>
          <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.153h7.594l5.243 6.932L18.9 1.153zm-1.291 19.502h2.039L6.486 3.239H4.298L17.61 20.655z"/></svg>
        </a>
        <span>MIT</span>
      </div>
    </footer>

    <!-- ─── Early access waitlist dialog ─── -->
    <dialog id="waitlist-dialog" aria-labelledby="waitlist-title">
      <div class="wl-inner">
        <button class="wl-close" id="wl-close" aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>

        <div class="wl-body" id="wl-body">
          <p class="wl-kicker">EARLY ACCESS</p>
          <h2 class="wl-title" id="waitlist-title">Get early access.</h2>
          <p class="wl-sub">We'll reach out when early access opens.</p>

          <form class="wl-form" id="wl-form" novalidate>
            <div class="wl-field">
              <label for="wl-name">Name</label>
              <input id="wl-name" name="name" type="text" placeholder="Your name" autocomplete="name" required />
            </div>
            <div class="wl-field">
              <label for="wl-email">Email</label>
              <input id="wl-email" name="email" type="email" placeholder="you@company.com" autocomplete="email" required />
            </div>
            <button class="wl-submit btn primary" type="submit">
              <span class="wl-submit-label">Join the waitlist →</span>
              <span class="wl-submit-loading" aria-hidden="true" hidden>Submitting…</span>
            </button>
            <p class="wl-error" id="wl-error" role="alert" hidden></p>
          </form>
        </div>

        <div class="wl-success" id="wl-success" hidden>
          <div class="wl-check" aria-hidden="true">✓</div>
          <h2 class="wl-title">You're on the list.</h2>
          <p class="wl-sub">We'll be in touch soon.</p>
        </div>
      </div>
    </dialog>

    <style>
      /* ─── Dialog / backdrop ─── */
      #waitlist-dialog {
        background: transparent;
        border: none;
        padding: 0;
        width: min(480px, calc(100vw - 32px));
        max-height: calc(100dvh - 32px);
        overflow: visible;
        /* centre in viewport */
        position: fixed;
        inset: 0;
        margin: auto;
      }
      #waitlist-dialog::backdrop {
        background: rgba(0, 0, 0, 0.72);
        backdrop-filter: blur(4px);
      }
      #waitlist-dialog:not([open]) { display: none; }

      /* ─── Card ─── */
      .wl-inner {
        position: relative;
        background: var(--dark);
        border: 1px solid rgba(253, 224, 71, 0.25);
        border-radius: var(--radius-xl);
        box-shadow: 0 0 0 1px rgba(253,224,71,0.08) inset, var(--shadow-dark), 0 0 40px rgba(253,224,71,0.06);
        padding: var(--space-10) var(--space-10) var(--space-10);
        color: var(--text-on-dark);
      }

      /* ─── Close button ─── */
      .wl-close {
        position: absolute;
        top: var(--space-5);
        right: var(--space-5);
        background: transparent;
        border: 1px solid var(--line-dark);
        border-radius: var(--radius-md);
        padding: var(--space-2);
        color: var(--muted-on-dark);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color var(--dur-base), border-color var(--dur-base);
      }
      .wl-close:hover {
        color: var(--text-on-dark);
        border-color: rgba(255,255,255,0.2);
      }

      /* ─── Content ─── */
      .wl-kicker {
        font-family: var(--font-mono);
        font-size: var(--text-2xs);
        font-weight: var(--weight-semibold);
        letter-spacing: var(--tracking-label);
        color: var(--accent-deep);
        margin: 0 0 var(--space-4);
      }
      .wl-title {
        font-size: var(--display-md);
        font-weight: var(--weight-medium);
        line-height: var(--leading-tight);
        letter-spacing: var(--tracking-display);
        color: var(--text-on-dark);
        margin: 0 0 var(--space-3);
      }
      .wl-sub {
        font-size: var(--text-base);
        color: var(--muted-on-dark);
        line-height: var(--leading-normal);
        margin: 0 0 var(--space-8);
      }

      /* ─── Form ─── */
      .wl-form {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
      }
      .wl-field {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
      }
      .wl-field label {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: var(--weight-semibold);
        letter-spacing: var(--tracking-label);
        text-transform: uppercase;
        color: var(--muted-on-dark);
      }
      .wl-field input {
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--line-dark);
        border-radius: var(--radius-md);
        padding: var(--space-4) var(--space-5);
        font-family: var(--font-sans);
        font-size: var(--text-md);
        color: var(--text-on-dark);
        outline: none;
        transition: border-color var(--dur-base);
        width: 100%;
      }
      .wl-field input::placeholder {
        color: rgba(168,162,158,0.5);
      }
      .wl-field input:focus {
        border-color: var(--accent);
        outline: var(--focus-width) solid var(--focus-color-dark);
        outline-offset: var(--focus-offset);
      }
      .wl-field input:invalid:not(:placeholder-shown) {
        border-color: var(--danger);
      }
      .wl-submit {
        margin-top: var(--space-2);
        width: 100%;
        justify-content: center;
        font-size: var(--text-md);
      }
      .wl-error {
        font-size: var(--text-base);
        color: var(--danger);
        margin: 0;
        font-family: var(--font-mono);
      }

      /* ─── Success state ─── */
      .wl-success {
        text-align: center;
        padding: var(--space-6) 0;
      }
      .wl-check {
        font-size: 40px;
        color: var(--accent);
        margin-bottom: var(--space-5);
        line-height: 1;
      }
      .wl-success .wl-sub {
        margin-bottom: 0;
      }
    </style>

    <script is:inline>
    (function () {
      var SUPABASE_URL  = 'https://ghkebzdbexoqxuzneayk.supabase.co';
      var SUPABASE_ANON = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imdoa2ViemRiZXhvcXh1em5lYXlrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ5OTAxOTQsImV4cCI6MjEwMDU2NjE5NH0.6-YwQFhxkVnTtOtyRnvOS-WPaKeUruYi0f3-cHfxJ0A';

      var dialog  = document.getElementById('waitlist-dialog');
      var form    = document.getElementById('wl-form');
      var body    = document.getElementById('wl-body');
      var success = document.getElementById('wl-success');
      var errEl   = document.getElementById('wl-error');
      var closeBtn = document.getElementById('wl-close');

      // Open on any #waitlist link
      document.querySelectorAll('a[href="#waitlist"]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          dialog.showModal();
        });
      });

      // Close on X button or backdrop click
      closeBtn.addEventListener('click', function () { dialog.close(); });
      dialog.addEventListener('click', function (e) {
        if (e.target === dialog) dialog.close();
      });

      // Reset form on close so it's fresh next open
      dialog.addEventListener('close', function () {
        form.reset();
        errEl.hidden = true;
        body.hidden = false;
        success.hidden = true;
        setLoading(false);
      });

      function setLoading(on) {
        var label   = form.querySelector('.wl-submit-label');
        var loading = form.querySelector('.wl-submit-loading');
        var submit  = form.querySelector('.wl-submit');
        label.hidden   = on;
        loading.hidden = !on;
        submit.disabled = on;
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        errEl.hidden = true;
        var name  = form.elements.name.value.trim();
        var email = form.elements.email.value.trim();
        if (!name || !email) return;

        setLoading(true);
        try {
          var res = await fetch(SUPABASE_URL + '/rest/v1/waitlist', {
            method: 'POST',
            headers: {
              'apikey':        SUPABASE_ANON,
              'Authorization': 'Bearer ' + SUPABASE_ANON,
              'Content-Type':  'application/json',
              'Prefer':        'return=minimal',
            },
            body: JSON.stringify({ name: name, email: email }),
          });
          if (!res.ok) {
            var data = await res.json().catch(function () { return {}; });
            // Supabase returns code '23505' for unique violations (duplicate email)
            if (data.code === '23505') {
              throw new Error('That email is already on the list.');
            }
            throw new Error('Something went wrong. Try again.');
          }
          body.hidden    = true;
          success.hidden = false;
        } catch (err) {
          errEl.textContent = err.message;
          errEl.hidden = false;
          setLoading(false);
        }
      });
    })();
    </script>
  </body>
</html>
