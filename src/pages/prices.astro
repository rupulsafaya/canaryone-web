---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Model Market — CanaryOne"
  description="What every model we track costs per million tokens, snapshotted nightly and plotted over time. Listed prices from the gateway's own data."
  path="/prices"
>
  <div class="page-band">
    <header class="page-head">
      <div class="container">
        <p class="kicker">MODEL MARKET</p>
        <h1>Model market</h1>
        <p class="lede">
          What every model we track costs per million tokens, snapshotted nightly and plotted
          over time. Prices are read straight from the gateway's own listings, so this is what
          a model is advertised at rather than what any particular run of it cost.
        </p>
      </div>
    </header>
  </div>

  <section class="tm">
    <div class="container">
      <div class="tm-controls">
        <div class="tm-group">
          <span class="tm-group-label" id="tm-metric-label">Price</span>
          <div class="tm-toggle" role="group" aria-labelledby="tm-metric-label" id="tm-metric">
            <!-- Buttons are written by the client script from METRICS, so the toggle and the
                 data layer can never disagree about which metrics exist. -->
          </div>
        </div>
        <div class="tm-group">
          <span class="tm-group-label" id="tm-scale-label">Axis</span>
          <div class="tm-toggle" role="group" aria-labelledby="tm-scale-label" id="tm-scale">
            <button type="button" data-scale="linear" aria-pressed="true">Linear</button>
            <button type="button" data-scale="logarithmic" aria-pressed="false">Log</button>
          </div>
        </div>
      </div>

      <p class="tm-note" id="tm-note"></p>

      <div class="tm-panel">
        <p class="tm-status" id="tm-status" role="status">Loading prices…</p>
        <div class="tm-canvas-wrap" id="tm-canvas-wrap" hidden>
          <canvas id="tm-chart" role="img"
            aria-label="Line chart of model price per million tokens over time. The same figures are available in the table below."
          ></canvas>
        </div>
      </div>

      <!-- Doubles as the chart's legend and its filter: every plotted model appears here
           with its colour, so identity never rests on colour alone. -->
      <fieldset class="tm-picker" id="tm-picker" hidden>
        <legend>
          Models <span class="tm-picker-count" id="tm-picker-count"></span>
        </legend>
        <div class="tm-picker-grid" id="tm-picker-grid"></div>
      </fieldset>

      <p class="tm-coverage" id="tm-coverage"></p>

      <details class="tm-table">
        <summary>Table view — every model, every snapshot</summary>
        <div class="tm-table-scroll" id="tm-table-mount"></div>
      </details>
    </div>
  </section>
</Layout>

<script>
  import {
    Chart,
    LineController,
    LineElement,
    PointElement,
    LinearScale,
    LogarithmicScale,
    Tooltip,
  } from 'chart.js';
  import {
    DEFAULT_METRIC,
    MAX_SERIES,
    METRICS,
    SERIES_COLORS,
    brandIconFor,
    describeCoverage,
    fetchSnapshots,
    formatSnapshotFull,
    formatSnapshotTick,
    formatUsdPerM,
    metricByKey,
    toSeries,
    type MetricKey,
    type PriceData,
    type SnapshotRow,
  } from '../lib/prices';

  Chart.register(LineController, LineElement, PointElement, LinearScale, LogarithmicScale, Tooltip);

  /**
   * Chart.js takes colours as strings rather than reading CSS variables, so the palette has
   * to be restated here. These must stay in step with :root in global.css.
   *
   * `grid` was rgba(15, 23, 42, 0.08) — a slate alpha, which is the one thing README
   * § Brand palette rule 3 rules out, because a cool alpha over warm cream reads blue. It is
   * now the flat --line hairline the rest of the site draws borders with.
   */
  const INK = {
    text: '#0f172a',      // --text
    muted: '#57534e',     // --muted
    grid: '#e5e7eb',      // --line
    axis: '#d1d5db',      // --line-strong
    surface: '#ffffff',   // --panel
  };

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const statusEl = el<HTMLParagraphElement>('tm-status');
  const canvasWrap = el<HTMLDivElement>('tm-canvas-wrap');
  const canvas = el<HTMLCanvasElement>('tm-chart');
  const noteEl = el<HTMLParagraphElement>('tm-note');
  const coverageEl = el<HTMLParagraphElement>('tm-coverage');
  const metricToggle = el<HTMLDivElement>('tm-metric');
  const scaleToggle = el<HTMLDivElement>('tm-scale');
  const picker = el<HTMLFieldSetElement>('tm-picker');
  const pickerGrid = el<HTMLDivElement>('tm-picker-grid');
  const pickerCount = el<HTMLSpanElement>('tm-picker-count');
  const tableMount = el<HTMLDivElement>('tm-table-mount');

  let rows: SnapshotRow[] = [];
  let metricKey: MetricKey = DEFAULT_METRIC;
  let scale: 'linear' | 'logarithmic' = 'linear';
  let data: PriceData = { timestamps: [], series: [] };
  let chart: Chart<'line'> | null = null;

  /**
   * Which model owns which palette slot. Keyed by model id and held for as long as that
   * model stays selected, so unticking one model never repaints the others — a colour
   * belongs to a model, not to its position in the list.
   */
  const slotByModel = new Map<string, number>();
  const selected = new Set<string>();

  function claimSlot(modelId: string): number {
    const existing = slotByModel.get(modelId);
    if (existing !== undefined) return existing;
    const taken = new Set(slotByModel.values());
    for (let i = 0; i < MAX_SERIES; i++) {
      if (!taken.has(i)) {
        slotByModel.set(modelId, i);
        return i;
      }
    }
    return -1;
  }

  function colorFor(modelId: string): string {
    const slot = slotByModel.get(modelId);
    return slot === undefined || slot < 0 ? INK.muted : SERIES_COLORS[slot];
  }

  function select(modelId: string) {
    if (selected.has(modelId) || selected.size >= MAX_SERIES) return;
    if (claimSlot(modelId) < 0) return;
    selected.add(modelId);
  }

  function deselect(modelId: string) {
    selected.delete(modelId);
    slotByModel.delete(modelId);
  }

  /** Builds the metric toggle from the data layer's list rather than hardcoded markup. */
  function renderMetricToggle() {
    metricToggle.innerHTML = '';
    for (const metric of METRICS) {
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.metric = metric.key;
      button.textContent = metric.label;
      button.setAttribute('aria-pressed', String(metric.key === metricKey));
      metricToggle.append(button);
    }
  }

  function syncToggles() {
    for (const b of metricToggle.querySelectorAll<HTMLButtonElement>('button')) {
      b.setAttribute('aria-pressed', String(b.dataset.metric === metricKey));
    }
    for (const b of scaleToggle.querySelectorAll<HTMLButtonElement>('button')) {
      b.setAttribute('aria-pressed', String(b.dataset.scale === scale));
    }
  }

  function renderPicker() {
    pickerGrid.innerHTML = '';
    for (const series of data.series) {
      const isOn = selected.has(series.modelId);
      const atCap = !isOn && selected.size >= MAX_SERIES;

      const label = document.createElement('label');
      label.className = 'tm-chip';
      if (isOn) label.classList.add('on');
      if (atCap) label.classList.add('capped');

      const input = document.createElement('input');
      input.type = 'checkbox';
      input.checked = isOn;
      input.disabled = atCap;
      input.value = series.modelId;

      const swatch = document.createElement('span');
      swatch.className = 'tm-swatch';
      swatch.style.background = isOn ? colorFor(series.modelId) : 'transparent';

      // Decorative: the model name sits immediately beside it, so an alt text would only
      // repeat what a screen reader is about to read anyway.
      const icon = brandIconFor(series.modelId);
      const brand = document.createElement('img');
      if (icon) {
        brand.className = 'tm-brand';
        brand.src = icon;
        brand.alt = '';
        brand.width = 16;
        brand.height = 16;
        brand.loading = 'lazy';
      }

      const name = document.createElement('span');
      name.className = 'tm-chip-name';
      name.textContent = series.label;

      const value = document.createElement('span');
      value.className = 'tm-chip-value';
      value.textContent = formatUsdPerM(series.latest);

      // A brand with no icon keeps its row aligned with the rest via a placeholder, so the
      // model names still line up in the grid.
      const slot = document.createElement('span');
      slot.className = 'tm-brand-slot';
      if (icon) slot.append(brand);

      label.append(input, swatch, slot, name, value);
      pickerGrid.append(label);
    }
    pickerCount.textContent = `${selected.size} of ${data.series.length} shown · ${MAX_SERIES} at a time`;
    picker.hidden = data.series.length === 0;
  }

  function renderTable() {
    if (!data.series.length) {
      tableMount.innerHTML = '<p class="tm-empty">No figures to tabulate for this metric.</p>';
      return;
    }

    const head = data.timestamps
      .map((t) => `<th scope="col">${formatSnapshotFull(t)}</th>`)
      .join('');
    const body = data.series
      .map((series) => {
        const cells = series.points
          .map((p) => `<td>${formatUsdPerM(p.y)}</td>`)
          .join('');
        const icon = brandIconFor(series.modelId);
        const brand = icon
          ? `<img class="tm-brand" src="${icon}" alt="" width="16" height="16" loading="lazy">`
          : '';
        return `<tr><th scope="row"><span class="tm-row-head"><span class="tm-brand-slot">${brand}</span><span>${series.label}<span class="tm-row-id">${series.modelId}</span></span></span></th>${cells}</tr>`;
      })
      .join('');

    tableMount.innerHTML = `<table class="tm-data-table"><caption>${
      metricByKey(metricKey).axisLabel
    }. A dash means the model did not report this metric in that snapshot.</caption><thead><tr><th scope="col">Model</th>${head}</tr></thead><tbody>${body}</tbody></table>`;
  }

  function buildDatasets() {
    return data.series
      .filter((s) => selected.has(s.modelId))
      .map((s) => ({
        label: s.label,
        data: s.points,
        borderColor: colorFor(s.modelId),
        backgroundColor: colorFor(s.modelId),
        borderWidth: 2,
        pointRadius: 3,
        pointHoverRadius: 6,
        pointBorderColor: INK.surface,
        pointBorderWidth: 1,
        // Straight segments: a price holds until the next snapshot observes a change, and a
        // smoothed curve would invent movement between the two readings.
        tension: 0,
        // Gaps stay gaps, so a model that reports nothing is visibly absent.
        spanGaps: false,
      }));
  }

  function render() {
    const metric = metricByKey(metricKey);
    noteEl.textContent = metric.note;
    coverageEl.textContent = describeCoverage(data.timestamps) ?? '';
    syncToggles();
    renderPicker();
    renderTable();

    if (!data.series.length) {
      canvasWrap.hidden = true;
      statusEl.hidden = false;
      statusEl.textContent =
        'No model reports this metric yet, so there is nothing to plot. The nightly job has to record it first.';
      chart?.destroy();
      chart = null;
      return;
    }

    statusEl.hidden = true;
    canvasWrap.hidden = false;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (chart) {
      chart.data.datasets = buildDatasets() as never;
      chart.options.scales!.y!.type = scale;
      (chart.options.scales!.y as { title: { text: string } }).title.text = metric.axisLabel;
      chart.update();
      return;
    }

    chart = new Chart(canvas, {
      type: 'line',
      data: { datasets: buildDatasets() as never },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: reduceMotion ? false : { duration: 220 },
        // A shared crosshair: hovering anywhere reads every selected model at that snapshot.
        interaction: { mode: 'index', intersect: false },
        parsing: false,
        scales: {
          x: {
            type: 'linear',
            border: { color: INK.axis },
            grid: { display: false },
            ticks: {
              color: INK.muted,
              maxRotation: 0,
              autoSkipPadding: 24,
              callback: (value) => formatSnapshotTick(Number(value)),
            },
          },
          y: {
            type: scale,
            border: { display: false },
            grid: { color: INK.grid },
            title: { display: true, text: metric.axisLabel, color: INK.muted },
            ticks: {
              color: INK.muted,
              callback: (value) => formatUsdPerM(Number(value)),
            },
          },
        },
        plugins: {
          // The picker above the chart is the legend, so Chart.js does not draw a second one.
          legend: { display: false },
          tooltip: {
            backgroundColor: '#0f0f10',
            titleColor: '#fef9c3',
            bodyColor: '#ffffff',
            borderColor: 'rgba(255,255,255,0.14)',
            borderWidth: 1,
            padding: 12,
            boxPadding: 6,
            callbacks: {
              title: (items) => (items.length ? formatSnapshotFull(items[0].parsed.x) : ''),
              label: (item) => {
                const point = item.raw as { providers: number | null };
                const price = formatUsdPerM(item.parsed.y);
                const providers = point?.providers;
                return providers
                  ? `${item.dataset.label}: ${price} /M · ${providers} providers`
                  : `${item.dataset.label}: ${price} /M`;
              },
            },
          },
        },
      },
    });
  }

  /**
   * Reshapes for the current metric and repairs the selection. Selections carry across a
   * metric switch, but a model that reports nothing for the new metric would be an invisible
   * tick, so it is dropped — and if that empties the selection we fall back to the most
   * expensive models that do report it.
   */
  function applyMetric() {
    data = toSeries(rows, metricKey);
    const available = new Set(data.series.map((s) => s.modelId));

    for (const modelId of [...selected]) {
      if (!available.has(modelId)) deselect(modelId);
    }
    if (selected.size === 0) {
      for (const series of data.series.slice(0, MAX_SERIES)) select(series.modelId);
    }
    render();
  }

  metricToggle.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-metric]');
    if (!button) return;
    metricKey = button.dataset.metric as MetricKey;
    applyMetric();
  });

  scaleToggle.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-scale]');
    if (!button) return;
    scale = button.dataset.scale as 'linear' | 'logarithmic';
    render();
  });

  pickerGrid.addEventListener('change', (event) => {
    const input = event.target as HTMLInputElement;
    if (input.type !== 'checkbox') return;
    if (input.checked) select(input.value);
    else deselect(input.value);
    render();
  });

  try {
    rows = await fetchSnapshots();
    if (!rows.length) {
      statusEl.textContent =
        'The snapshot table is empty. Once the nightly job has run at least once, prices appear here.';
      renderMetricToggle();
    } else {
      renderMetricToggle();
      applyMetric();
    }
  } catch (error) {
    statusEl.classList.add('error');
    statusEl.textContent = `Could not load prices: ${
      error instanceof Error ? error.message : 'unknown error'
    }. This chart reads Supabase directly from your browser, so a network block or an ad blocker will stop it.`;
    renderMetricToggle();
  }
</script>
