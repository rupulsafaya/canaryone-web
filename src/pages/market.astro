---
/**
 * /market — the open-weight model market, host by host.
 *
 * ROUTE RENAMED 2026-08-11 from /prices, which is deliberately left free for a future
 * page about what CanaryOne costs. Inbound links to /prices will 404 rather than
 * redirect: a redirect would occupy the route we are freeing up. The page is nine days
 * old and was a chart of listed prices, so there is little to lose.
 *
 * WHAT CHANGED AND WHY, 2026-08-11
 *   This page used to be a Chart.js time machine of one listed price per model over time,
 *   read from Supabase at runtime. It read as a data dump: a model-level line hides the
 *   only thing here worth knowing, which is that the same weights cost different amounts,
 *   offer different context windows and support different features depending on who serves
 *   them. A model-level average is precisely the wrong grain.
 *
 *   It is now built from src/data/market.json, generated by tools/build_market_data.py in
 *   the fantastic-dollop repository from the free metadata capture. Static, no runtime
 *   fetch, no database. Refreshing the page is: regenerate, commit, Vercel rebuilds.
 *
 * EVERY FIGURE HERE IS FREE TO REPRODUCE
 *   Nothing on this page comes from the paid benchmark. That is deliberate. A figure that
 *   costs money to refresh goes stale in public, and this page is read by strangers
 *   indefinitely.
 *
 * THE NUMBER GATE, from COPY.md
 *   The capture timestamp is in the page header and repeated on every card, and each model
 *   links to its own OpenRouter page so a reader can check any figure in about ten seconds.
 *   For listed metadata that is a better "one click away" than our own run would be.
 *
 * WHAT IS NOT HERE, ON PURPOSE
 *   No quality or accuracy claim: listed metadata cannot support one.
 *   No latency percentiles: they are a 30-minute rolling window sampled once, and a reader
 *   will take them for a property of the host.
 *   No ranking of hosts. Hosts appear as the two ends of a spread, which is a price fact.
 */
import Layout from '../layouts/Layout.astro';
import market from '../data/market.json';

const captured = new Date(market.captured_at);
const capturedLabel = captured.toLocaleString('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric',
  hour: '2-digit', minute: '2-digit', timeZone: 'UTC',
}) + ' UTC';

const usd = (n: number) =>
  n >= 1 ? `$${n.toFixed(2)}` : `$${n.toFixed(n < 0.01 ? 4 : 3)}`;
const tokens = (n: number) =>
  n >= 1_000_000 ? `${(n / 1_000_000).toFixed(n % 1_000_000 === 0 ? 0 : 1)}M`
  : n >= 1000 ? `${Math.round(n / 1000)}K` : `${n}`;
const ratio = (n: number) => `${n.toFixed(n < 10 ? 1 : 0)}×`;

/** The four headline facts. Each is one sentence a reader can act on. */
const widest = market.models[0];
const widestContext = [...market.models]
  .filter((m) => m.context && m.context.ratio > 1)
  .sort((a, b) => b.context!.ratio - a.context!.ratio)[0];
const widestCache = [...market.models]
  .filter((m) => m.cache_read && m.cache_read.ratio > 1)
  .sort((a, b) => b.cache_read!.ratio - a.cache_read!.ratio)[0];
const undisclosed = market.models.reduce((a, m) => a + m.undisclosed_precision, 0);
const toolGaps = market.models.reduce((a, m) => a + (m.caps_missing.tools ?? 0), 0);
---

<Layout
  title="The open-weight model market — CanaryOne"
  description="What each open-weight model costs across every host serving it, with the context window, precision and capabilities each host actually offers. Listed metadata, captured continuously."
  path="/market"
>
  <div class="page-band">
    <header class="page-head">
      <div class="container">
        <p class="kicker">THE MARKET</p>
        <h1>The same weights, different deals</h1>
        <p class="lede">
          An open-weight model is not one product. It is as many products as there are
          companies serving it, and they disagree on price, on how much context they will
          give you, on what precision they run and on whether the features you picked the
          model for work at all. This is that disagreement, measured continuously.
        </p>
        <p class="mk-stamp">
          Captured <strong>{capturedLabel}</strong> · {market.totals.host_endpoints} host
          endpoints across {market.totals.models_published} models ·
          {market.captures_on_record} captures since {market.series_began}
        </p>
      </div>
    </header>
  </div>

  <section class="section">
    <div class="container">
      <div class="mk-tiles">
        <div class="mk-tile">
          <p class="mk-tile-n">{ratio(widest.price_in.ratio)}</p>
          <p class="mk-tile-l">widest price gap</p>
          <p class="mk-tile-s">
            {widest.name}, across {widest.price_in.n} hosts. Cheapest
            {usd(widest.price_in.min)} and dearest {usd(widest.price_in.max)} per million
            input tokens, for identical weights.
          </p>
        </div>
        {widestContext && (
          <div class="mk-tile">
            <p class="mk-tile-n">{ratio(widestContext.context!.ratio)}</p>
            <p class="mk-tile-l">widest context gap</p>
            <p class="mk-tile-s">
              {widestContext.name} is served with as little as
              {' '}{tokens(widestContext.context!.min)} of context by one host and
              {' '}{tokens(widestContext.context!.max)} by another. The model card tells you
              the ceiling, not what you get.
            </p>
          </div>
        )}
        {widestCache && (
          <div class="mk-tile">
            <p class="mk-tile-n">{ratio(widestCache.cache_read!.ratio)}</p>
            <p class="mk-tile-l">widest cache-read gap</p>
            <p class="mk-tile-s">
              On {widestCache.name}. Agents re-send their context every turn, so what a host
              charges to read its own cache can move the bill more than the headline price
              does — and almost nobody compares it.
            </p>
          </div>
        )}
        <div class="mk-tile">
          <p class="mk-tile-n">{undisclosed}</p>
          <p class="mk-tile-l">hosts not stating precision</p>
          <p class="mk-tile-s">
            Out of {market.totals.host_endpoints}. Quantisation changes how a model behaves,
            and these hosts do not say which they run. {toolGaps > 0 && (
              <>A further {toolGaps} do not offer tool calling for a model whose other hosts
              do.</>
            )}
          </p>
        </div>
      </div>
    </div>
  </section>

  {market.price_moves.length > 0 && (
    <section class="section mk-moves-section">
      <div class="container">
        <h2>Moved in the last day</h2>
        <p class="mk-sub">
          Listed input price, this capture against the nearest capture about twenty-four
          hours earlier. Anything above two percent.
        </p>
        <ul class="mk-moves">
          {market.price_moves.map((m) => (
            <li>
              <span class={m.pct < 0 ? 'mk-move-down' : 'mk-move-up'}>
                {m.pct > 0 ? '+' : ''}{m.pct.toFixed(0)}%
              </span>
              <span class="mk-move-model">{m.model}</span>
              <span class="mk-move-tag">{m.tag}</span>
              <span class="mk-move-val">{usd(m.before)} → {usd(m.after)}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <h2>Every model we watch</h2>
      <p class="mk-sub">
        Sorted by how much the price disagrees across hosts. Hosts are named as the two ends
        of a spread — that is a price fact, and nothing here ranks a host or says anything
        about how well it serves the model.
      </p>

      <div class="mk-cards">
        {market.models.map((m) => (
          <article class="mk-card">
            <header class="mk-card-head">
              <div>
                <h3>{m.name}</h3>
                <p class="mk-card-meta">
                  <code>{m.id}</code>
                  {m.open_weights ? <span class="mk-pill mk-pill-open">open weights</span>
                                  : <span class="mk-pill">no public weights</span>}
                </p>
              </div>
              <a class="mk-check" href={m.or_url} rel="noopener" target="_blank">
                check on OpenRouter →
              </a>
            </header>

            <div class="mk-row">
              <span class="mk-k">Hosts</span>
              <span class="mk-v">
                {m.hosts_listed} listed
                {m.hosts_deranked > 0 && (
                  <span class="mk-dim"> · {m.hosts_deranked} deranked right now</span>
                )}
                {m.hf_providers_live != null && (
                  <span class="mk-dim"> · {m.hf_providers_live} on Hugging Face</span>
                )}
              </span>
            </div>

            {m.price_in && (
              <div class="mk-row">
                <span class="mk-k">Input price</span>
                <span class="mk-v">
                  <strong>{ratio(m.price_in.ratio)}</strong> gap ·
                  {' '}{usd(m.price_in.min)} to {usd(m.price_in.max)} per 1M
                  <span class="mk-dim"> · {m.cheapest_tag} to {m.dearest_tag}</span>
                </span>
              </div>
            )}

            {m.cache_read && m.cache_read.ratio > 1.05 && (
              <div class="mk-row">
                <span class="mk-k">Cache read</span>
                <span class="mk-v">
                  <strong>{ratio(m.cache_read.ratio)}</strong> gap ·
                  {' '}{usd(m.cache_read.min)} to {usd(m.cache_read.max)} per 1M
                </span>
              </div>
            )}

            {m.context && m.context.ratio > 1.01 && (
              <div class="mk-row">
                <span class="mk-k">Context window</span>
                <span class="mk-v">
                  <strong>{ratio(m.context.ratio)}</strong> gap ·
                  {' '}{tokens(m.context.min)} to {tokens(m.context.max)} tokens
                </span>
              </div>
            )}

            <div class="mk-row">
              <span class="mk-k">Precision</span>
              <span class="mk-v">
                {m.precisions.filter((p) => p !== 'unknown').join(', ') || 'none stated'}
                {m.undisclosed_precision > 0 && (
                  <span class="mk-dim">
                    {' '}· {m.undisclosed_precision} of {m.hosts_listed} do not say
                  </span>
                )}
              </span>
            </div>

            {Object.keys(m.caps_missing).length > 0 && (
              <div class="mk-row mk-row-warn">
                <span class="mk-k">Feature gaps</span>
                <span class="mk-v">
                  {Object.entries(m.caps_missing).map(([cap, n], i) => (
                    <>{i > 0 && ' · '}<code>{cap}</code> missing on {n}</>
                  ))}
                </span>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section mk-limits-section">
    <div class="container">
      <h2>What this does and does not show</h2>
      <p class="mk-sub">
        Put here rather than in a footnote, because a page is read by strangers indefinitely
        and every one of these is a way the numbers above could be misread.
      </p>
      <ul class="mk-limits">
        {market.limits.map((l) => <li>{l}</li>)}
      </ul>
      <p class="mk-foot">
        Built from {market.totals.catalogue_models} models in the OpenRouter catalogue, of
        which {market.totals.catalogue_open_weight} publish weights. Captured
        {' '}{capturedLabel}; regenerated from the capture rather than edited by hand.
      </p>
    </div>
  </section>
</Layout>

<style>
  .mk-stamp {
    margin-top: 14px; font-size: 0.85rem; color: var(--muted);
    font-family: var(--font-mono);
  }
  .mk-stamp strong { color: var(--text); }

  /* Headline tiles. Four facts, each a full sentence, because a bare number with a label
     is the data-dump failure this page is a rewrite of. */
  .mk-tiles {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px;
  }
  .mk-tile {
    background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
    padding: 20px;
  }
  .mk-tile-n {
    margin: 0; font-size: 2.4rem; font-weight: 680; letter-spacing: -0.03em;
    line-height: 1;
  }
  .mk-tile-l {
    margin: 6px 0 10px; font-size: 0.72rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--muted); font-weight: 600;
  }
  .mk-tile-s { margin: 0; font-size: 0.88rem; color: var(--muted); line-height: 1.5; }

  .mk-sub {
    margin: 6px 0 22px; color: var(--muted); font-size: 0.92rem; max-width: 68ch;
    line-height: 1.55;
  }

  .mk-moves-section { background: var(--bg-tint); }
  .mk-moves { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .mk-moves li {
    display: grid; grid-template-columns: 68px 1fr auto auto; gap: 14px;
    align-items: baseline; padding: 10px 14px; background: var(--panel);
    border: 1px solid var(--line); border-radius: 8px; font-size: 0.88rem;
  }
  .mk-move-down { color: var(--good); font-weight: 650; font-variant-numeric: tabular-nums; }
  .mk-move-up { color: var(--danger); font-weight: 650; font-variant-numeric: tabular-nums; }
  .mk-move-model { font-family: var(--font-mono); font-size: 0.82rem; }
  .mk-move-tag { color: var(--muted); font-family: var(--font-mono); font-size: 0.78rem; }
  .mk-move-val {
    color: var(--muted); font-variant-numeric: tabular-nums; font-size: 0.82rem;
  }

  .mk-cards { display: grid; gap: 16px; }
  .mk-card {
    background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
    padding: 18px 20px;
  }
  .mk-card-head {
    display: flex; justify-content: space-between; align-items: flex-start; gap: 18px;
    padding-bottom: 12px; margin-bottom: 6px; border-bottom: 1px solid var(--line);
  }
  .mk-card-head h3 { margin: 0; font-size: 1.05rem; letter-spacing: -0.01em; }
  .mk-card-meta {
    margin: 5px 0 0; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
  }
  .mk-card-meta code { font-size: 0.78rem; color: var(--muted); }
  .mk-pill {
    font-size: 0.68rem; letter-spacing: 0.04em; text-transform: uppercase;
    padding: 2px 7px; border-radius: 999px; background: var(--info-bg);
    color: var(--info); font-weight: 600;
  }
  .mk-pill-open { background: var(--good-bg); color: var(--good); }
  .mk-check {
    flex: none; font-size: 0.8rem; color: var(--muted); text-decoration: none;
    border-bottom: 1px solid var(--line-strong); padding-bottom: 1px; white-space: nowrap;
  }
  .mk-check:hover { color: var(--text); border-color: var(--accent-deep); }

  .mk-row {
    display: grid; grid-template-columns: 132px 1fr; gap: 14px; padding: 7px 0;
    font-size: 0.88rem; align-items: baseline;
  }
  .mk-k {
    color: var(--muted); font-size: 0.74rem; letter-spacing: 0.05em;
    text-transform: uppercase; font-weight: 600;
  }
  .mk-v { font-variant-numeric: tabular-nums; }
  .mk-v code { font-size: 0.82rem; }
  .mk-dim { color: var(--muted); }
  .mk-row-warn .mk-k { color: var(--warn); }

  .mk-limits-section { background: var(--bg-tint); }
  .mk-limits { margin: 0; padding-left: 20px; max-width: 78ch; }
  .mk-limits li {
    margin-bottom: 10px; color: var(--muted); font-size: 0.9rem; line-height: 1.55;
  }
  .mk-foot {
    margin-top: 20px; font-size: 0.8rem; color: var(--muted);
    font-family: var(--font-mono);
  }

  @media (max-width: 640px) {
    .mk-row { grid-template-columns: 1fr; gap: 2px; }
    .mk-moves li { grid-template-columns: 60px 1fr; }
    .mk-card-head { flex-direction: column; gap: 10px; }
  }
</style>
