    font-size: var(--text-sm);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    background: var(--bg);
  }
  /* Inside the one block the parts stop being purchases, so they lose their own borders. */
  .hp-swap-one {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-tint);
    padding: var(--space-4);
  }
  .hp-swap-parts--in > li { border: 0; background: transparent; padding: var(--space-2) 0; }
  .hp-swap-foot {
    font-size: var(--text-base);
    color: var(--muted);
    margin: var(--space-4) 0 0;
  }
  .hp-swap-arrow {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--muted);
    margin: 0;
  }

  /* ---- 4. intelligence ----
     The one tinted section on the page, because it is the one carrying figures. */
  .hp-intel { background: var(--bg-tint); }
  /* On the tint, a panel's own cream keeps the modules reading as objects on a surface. */
  .hp-mod { padding: var(--space-8) var(--space-7); display: flex; flex-direction: column; }
  .hp-mod h3 {
    font-size: var(--display-md);
    font-weight: var(--weight-medium);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    margin: 0 0 var(--space-4);
  }
  .hp-mod-sub {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--muted);
    margin: 0 0 var(--space-6);
  }
  /* Pushed to the foot of the card so both modules' source lines sit on one line, whatever the
     object above them is. */
  .hp-mod-src {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--muted);
    margin: auto 0 0;
    padding-top: var(--space-5);
  }
  .hp-mod-src a { color: var(--text); border-bottom: 1px solid var(--line-strong); }
  .hp-mod-src a:hover { border-bottom-color: currentColor; }
  /* The sentence that reads the strip, at note weight rather than lede weight: it explains a
     mark, which is what .sec-note does for a chart in the section shell. */
  .hp-mod-note {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--muted);
    margin: var(--space-4) 0 0;
  }
  .hp-mod-link { margin: var(--space-4) 0 0; }
  .hp-mod-link a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
    border-bottom: 1px solid var(--line-strong);
  }
  .hp-mod-link a:hover { border-bottom-color: currentColor; }

  /* The price strip. One dot per host on a log axis, because the range is past tenfold and a
     linear axis piles every host but the dearest into the first tenth of the track. Two dot
     sizes and no third, matching /market: the dearest host is the finding and takes the ink,
     everything else recedes. */
  .hp-strip { margin: 0 0 var(--space-2); }
  .hp-strip svg { display: block; width: 100%; height: auto; overflow: visible; }
  .hp-strip-axis { stroke: var(--line-strong); stroke-width: 1; }
  .hp-strip-mid { stroke: var(--line-strong); stroke-width: 1; }
  .hp-strip-dot { fill: var(--muted); opacity: 0.5; }
  .hp-strip-dot--hi { fill: var(--text); opacity: 1; }
  .hp-strip-ends {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    margin-top: var(--space-2);
  }

  /* .tm-data-table, which right-aligns everything and left-aligns its row headers. Only the
     first column's width needs saying. */
  .hp-routes th[scope='row'] { width: 34%; }
  /* The table holds its width and its own wrapper scrolls, which is what .tm-table-scroll does
     for a wide table elsewhere. Every cell in the contract is nowrap, so without this the
     table's min-content width becomes the grid column's floor and the whole page scrolls
     sideways on a phone. */
  .hp-routes-wrap { overflow-x: auto; }

  /* ---- 5. migration ---- */
  .hp-flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
