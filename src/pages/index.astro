---
/**
 * / — the home page.
 *
 * TOOK THE ROUTE ON 2026-08-14, replacing the flywheel page that had held it since the site was
 * repositioned onto the four pillars. That page is not in git history alone: it is kept whole at
 * archive/home-flywheel.astro, which is outside src/pages/ and therefore not built and not
 * served. Restoring it is one `git mv` back — see its own header.
 *
 * WHY IT CHANGED. The old page sold the four pillars of a command-line tool — Test, Tune, Deploy,
 * Improve. The company those pillars belong to is described in Strategy/AIBOX-VISION.md in
 * fantastic-dollop, and it is a packaged AI stack rather than an eval tool. This page is the
 * first expression of that, and it is built to be understood by a visitor who never learns the
 * words routing, RAG, eval or open-weight. The benchmarking tool is still here; it is the
 * measurement layer underneath the model shelf rather than the whole company.
 *
 * THE REGISTER IS THE HARD PART, AND IT IS WHY THIS PAGE READS THE WAY IT DOES. Almost nothing in
 * the vision ships. What ships is the benchmarking CLI, the free daily market capture and the
 * paid nightly sweep. COPY.md § The three registers says the status belongs in the sentence
 * rather than in a nearby button, and that describing a mechanism implies it exists — so every
 * unbuilt surface on this page is written as "we're building" or "we plan to", and no unbuilt
 * mechanism is specified. The measurement sections are the only ones in the present indicative,
 * which is also what makes them do the credibility work the page needs them to do.
 *
 * EVERY FIGURE IS GENERATED, none typed. The market half comes from src/data/market.json and the
 * workload half from src/data/example-run.json, which are the same two payloads /market and
 * /evals read. The three routes in § intelligence are selected by the same rule /evals uses —
 * cheapest, cheapest-that-finished-most, most-finished — so the two pages cannot tell different
 * stories about one run.
 *
 * TWO DEPARTURES FROM THE BRIEF IT WAS BUILT FROM, both deliberate:
 *
 *   THE BRIEF'S FIRST THREE SECTIONS ARE TWO. It asked for a surfaces-to-layer composite in the
 *   hero, then a section on the three surfaces, then a section headed "One system instead of five
 *   vendors" carrying a layered architecture diagram. Built that way and reviewed on 2026-08-14,
 *   it stated one thesis three times: the reader met the architecture in the hero before the
 *   argument for it, then met the argument, then met a second display headline and a second
 *   full screen making the same point in boxes. The hero is now copy only, and § one system is a
 *   single object in three parts — the surfaces, the layer they converge on, and a two-line
 *   contrast at its foot. That is the brief's own visual-density rule applied to the brief: one
 *   major idea per section, and never the same claim in two formats.
 *
 *   THE CTAs ARE "GET EARLY ACCESS" AND THE INSTALL LINE, not "Get started" and "Talk to us".
 *   There is no sign-up and no contact address on this site; the waitlist dialog in Layout.astro
 *   is the only mechanism either button could reach, and two buttons opening one dialog is worse
 *   than one. The ghost button sends a technical reader to the thing that does exist.
 *
 * NO CLIENT JAVASCRIPT AND NO ANIMATION. This page removed the site's one looping animation with
 * the flywheel, so the site now has none — DESIGN.md § Motion was rewritten to say so rather than
 * left describing a page that is no longer served.
 *
 * STILL OPEN, and deliberately not decided here: Strategy/positioning.md and Strategy/concept.md
 * in fantastic-dollop describe the CLI-only company. COPY.md says positioning.md is the source
 * every sentence on this site inherits from, so it is now behind the front door rather than
 * ahead of it, and that is a gap to close rather than a state to keep.
 */
import { Image } from 'astro:assets';
import Layout, { GITHUB_URL } from '../layouts/Layout.astro';
import market from '../data/market.json';
import run from '../data/example-run.json';
import viewLeaderboard from '../assets/report-view-leaderboard.png';
import { spell, mult, day, stamp, usd, usd4, priceWords } from '../lib/prose';

const TITLE = 'CanaryOne — your company’s AI stack, without the assembly';
const DESCRIPTION =
  'We’re building one place for a company to use AI — chat, company knowledge, coding and API access — over a model layer we measure every night. Start with the models you already use.';

const DEMO_REPORT = run.reportUrl;

/* ---------------------------------------------------------------------------
   § INTELLIGENCE, module A — the market.

   The widest listed price spread on the board, found rather than hand-picked, so a re-generated
   payload cannot leave the headline pointing at a model whose spread has since closed. Only
   open-weight models with more than one host can have a spread at all.
   --------------------------------------------------------------------------- */
const spreadModel = market.models
  .filter((x: any) => x.open_weights && x.price_in && x.price_in.n > 1)
  .sort((a: any, b: any) => b.price_in.ratio - a.price_in.ratio)[0];

const spLo = spreadModel.price_in.min;
const spHi = spreadModel.price_in.max;
/* Logarithmic, for the reason /market's ladder is: the range is past tenfold, and on a linear
   axis every host but the dearest piles into the leftmost tenth of the track. */
const lg = (v: number) => Math.log10(v);
const spX = (v: number) => ((lg(v) - lg(spLo)) / (lg(spHi) - lg(spLo))) * 100;
/* One dot per host that reports a price. The scatter is one short of hosts_listed, so the count
   in the copy is the scatter's own length rather than the listing count — a strip with nineteen
   dots under the word twenty is the kind of small wrongness a technical reader stops on. */
const spDots = [...spreadModel.scatter]
  .map((s: any) => s.price)
  .filter((p: number) => p != null)
  .sort((a: number, b: number) => a - b);

/* ---------------------------------------------------------------------------
   § INTELLIGENCE, module B — the workload.

   The same three routes /evals shows, selected by the same rule so the two pages cannot disagree
   about one run: the cheapest route, the cheapest route that finished most of the work, and the
   route that finished all of it. Lettered by cost, cheapest first — COPY.md § Naming a host: a
   single local run cannot carry company names, and the report one click away names all ten.
   --------------------------------------------------------------------------- */
type Lane = (typeof run.lanes)[number];
const byCost = (a: Lane, b: Lane) => a.costPerPass - b.costPerPass;
const RELIABLE = 0.75;

const cheapest = [...run.lanes].sort(byCost)[0];
const reliable = [...run.lanes]
  .filter((l) => l.passed / l.attempted >= RELIABLE && l.slug !== cheapest.slug)
  .sort(byCost)[0];
const complete = [...run.lanes]
  .filter((l) => l.slug !== cheapest.slug && l.slug !== reliable.slug)
  .sort((a, b) => b.passed - a.passed || a.costPerPass - b.costPerPass)[0];

const shown = [cheapest, reliable, complete].sort(byCost);
const LETTERS = ['Route A', 'Route B', 'Route C'];

const runId = run.runId.split('-')[0];
const runBar = [`run ${runId}`, `${run.totals.lanes} routes`, `${run.totals.tasks} tasks`,
  `${run.totals.repeats} repeats each`].join(' · ');
---

<Layout title={TITLE} description={DESCRIPTION} path="/">
  <!-- ─── HERO ───
       Copy only, and that is the decision worth recording. It carried the surfaces-to-layer
       diagram until 2026-08-14, which meant the reader met the architecture before the argument
       and then met it again one screen later in § one system. The diagram was not wrong, it was
       early: it is the object of the section that makes the claim it illustrates, and the hero
       now ends on the maturity line. -->
  <section class="hero">
    <div class="container">
      <div class="hp-hero-copy">
        <p class="kicker">CANARYONE</p>
        <h1>Your company&rsquo;s AI stack, <span class="em">without the assembly.</span></h1>
        <p class="sub">
          Companies end up stitching together chat, knowledge, coding, routing and admin from
          different vendors. We&rsquo;re building the box they should have come in, over a model
          layer we measure ourselves.
        </p>
        <div class="ctas">
          <a class="btn primary" href="#waitlist">Get early access &rarr;</a>
          <a class="btn ghost" href="/evals#install">
            <span>$&nbsp;npx&nbsp;canaryone</span>
          </a>
        </div>
        <p class="hp-trust">
          The benchmarking tool ships today &middot; the platform is in build &middot; every
          figure on this site links to the run behind it
        </p>
      </div>

    </div>
  </section>

  <!-- ─── 2. ONE SYSTEM ───
       MERGED FROM TWO SECTIONS ON 2026-08-14. This was "AI people can use, infrastructure the
       company can control" followed by a second full section headed "One system instead of five
       vendors", carrying a five-boxes-against-one-box diagram. They are chapter one and chapter
       two of a single argument — there are three useful surfaces and they share one substrate —
       and giving the second half its own display headline and its own screen made the page state
       the thesis twice.

       So the section is one object built in three parts, which is the argument in the order it is
       made: the three surfaces, the layer they converge on, and the purchase that replaces. The
       contrast at the foot is two lines rather than the old diagram, because the hero already
       names the five tools in prose and a reader does not need them enumerated a second time in
       boxes. One screen, one headline, nothing lost.

       Every card opens on "we're building", because COPY.md puts the register in the sentence
       rather than in a badge beside it, and because a visitor who reads one card and leaves
       should still have been told the truth. -->
  <section class="section">
    <div class="container">
      <div class="sec-copy">
        <p class="kicker">ONE SYSTEM</p>
        <h2>AI people can use.<br />Infrastructure the company can control.</h2>
        <p class="lede">
          We&rsquo;re building three surfaces on one shared layer, so a company does not have to
          buy them separately and then make them agree with each other.
        </p>
      </div>

      <div class="hp-system">
        {/* A SURFACE, NOT A FEATURE LIST: the name is the heading and one sentence says what a
            person does there. The three cards carried an eyebrow, a descriptive title and a
            three-line paragraph each, which read as a product tour of something that does not
            exist yet.

            THE BADGE CARRIES THE REGISTER, and that is a deliberate reading of COPY.md rather
            than a shortcut around it. Every card used to open on "We're building", which is the
            rule followed literally — three times on one row, at the cost of the sentence saying
            anything. What COPY.md actually forbids is a status that lives on a button while the
            prose beside it describes a mechanism in the present indicative, because a skimmer
            reads the prose and never the button. A chip inside the card, above the sentence it
            qualifies, is read by exactly the person who skims. The section's lede stays in the
            building register underneath it, so the status is also in a sentence. */}
        <div class="hp-cards hp-cards-3">
          <div class="panel hp-card">
            <div class="hp-card-top">
              <h3>Ask</h3>
              <span class="hp-status">In build</span>
            </div>
            <p>
              Ask questions across company information without copying documents into another
              tool.
            </p>
          </div>
          <div class="panel hp-card">
            <div class="hp-card-top">
              <h3>Build</h3>
              <span class="hp-status">In build</span>
            </div>
            <p>
              Give engineers an OpenAI-compatible API and coding tools on the same model layer.
            </p>
          </div>
          <div class="panel hp-card">
            <div class="hp-card-top">
              <h3>Control</h3>
              <span class="hp-status">In build</span>
            </div>
            <p>
              Manage people, model access, budgets, policy and audit across every surface.
            </p>
          </div>
        </div>

        <!-- Three surfaces converging on one layer. Hairlines only; the geometry is percentages
             so each tick lands on its own column's centre whatever the container is doing. -->
        <div class="hp-bus" aria-hidden="true">
          <span class="hp-bus-tick hp-bus-tick--l"></span>
          <span class="hp-bus-tick hp-bus-tick--c"></span>
          <span class="hp-bus-tick hp-bus-tick--r"></span>
          <span class="hp-bus-line"></span>
          <span class="hp-bus-drop"></span>
        </div>

        {/* THE LAYER, WITH THE PRODUCT'S OWN NAME IN IT. It was an eyebrow over a row of four
            plain words, which described the layer without ever showing one — three surfaces
            plugging into a sentence rather than into a system. The lockup anchors it, and the
            four capabilities became tiles so the box reads as something built.

            THE LIGHT LOCKUP, NOT THE DARK ONE. c1-logo.svg normalises its wordmark to #0f0f10,
            which is --dark: correct here and invisible on the nav's own surface, which is why
            two files exist. Held to 120x22, the pair the nav already drops to on a phone, so the
            5.4504:1 ratio is one a reviewer has seen rather than a third arbitrary size. It is
            decorative for a screen reader because the eyebrow directly above it says the name. */}
        <div class="hp-core">
          <p class="micro hp-core-label">One CanaryOne layer</p>
          <img class="hp-core-mark" src="/c1-logo.svg" alt="" width="120" height="22" />

          {/* Line icons rather than filled glyphs, at a 16-unit box and one stroke width. They
              are schematic on purpose — a group, a document, two controls, a measurement — and
              they sit at --muted so the labels still lead. */}
          <ul class="hp-core-items">
            <li>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="6" cy="5.5" r="2.5" />
                <path d="M1.5 13.5c0-2.2 2-3.5 4.5-3.5s4.5 1.3 4.5 3.5" />
                <path d="M11 3.4a2.5 2.5 0 0 1 0 4.2" />
                <path d="M12.6 10.4c1.2.5 1.9 1.6 1.9 3.1" />
              </svg>
              <span>Shared identity</span>
            </li>
            <li>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2.5 4.5v9h6" />
                <path d="M5.5 2.5h4l3 3v8h-7z" />
                <path d="M9.5 2.5v3h3" />
              </svg>
              <span>Company knowledge</span>
            </li>
            <li>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 5h12M2 11h12" />
                <circle cx="6" cy="5" r="1.7" />
                <circle cx="10" cy="11" r="1.7" />
              </svg>
              <span>Policy &amp; budgets</span>
            </li>
            <li>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2.5 13.5h11" />
                <path d="M5 13.5V9.5M8 13.5V5M11 13.5V7.5" />
              </svg>
              <span>Measured model layer</span>
            </li>
          </ul>
        </div>

        <!-- The packaging thesis in one line. It was a panel of five bordered boxes against one
             bordered box, then a two-row label list, and it is a single sentence-shaped row now:
             the hero names the five things in prose, so the count is the only part that needs
             showing. The arrow is a graphic inside a diagram, which is where COPY.md allows one. -->
        <p class="hp-contrast">
          Usually: 5 tools &middot; 5 consoles &middot; 5 bills
          <span class="hp-contrast-arrow" aria-hidden="true">&rarr;</span>
          <span class="hp-contrast-ours">CanaryOne: one layer</span>
        </p>
      </div>

    </div>
  </section>

  <!-- ─── 4. INTELLIGENCE ───
       The bridge between the company we are describing and the machinery that already exists.
       Two modules, and they are different kinds of evidence on purpose: the market half is free
       metadata read several times a day, the workload half is a measured run. The evidence
       footer keeps them apart, because a sentence that mixes them is the specific error
       CLAUDE.md in fantastic-dollop warns about.

       Tinted, so the one section on the page carrying figures reads as its own block. -->
  <section class="section hp-intel">
    <div class="container">
      <div class="sec-copy">
        <p class="kicker">CANARYONE INTELLIGENCE</p>
        <h2>The model layer is measured, not guessed.</h2>
        <p class="lede">
          A shelf of models picked off a public leaderboard is a guess about somebody else&rsquo;s
          workload. We read what the market advertises every day, and we measure what real work
          costs on each route.
        </p>
        <p class="claim">
          Market intelligence tells us where to look. Workload benchmarking tells you what
          actually wins.
        </p>
      </div>

      <div class="hp-cards hp-cards-2">
        <!-- Module A — the market. One model's listed price across every host serving it. -->
        <div class="panel hp-mod">
          <p class="micro">MARKET INTELLIGENCE</p>
          <h3>
            The same model, {mult(spreadModel.price_in.ratio)} the price
            depending on where it runs.
          </h3>
          <p class="hp-mod-sub">
            {spreadModel.short}, as advertised by the companies serving it. Each dot is one host.
          </p>

          <div class="hp-strip">
            <svg viewBox="0 0 400 44" role="img"
                 aria-label={`Listed input price for ${spreadModel.short} across ${spDots.length} hosts, from ${usd(spLo)} to ${usd(spHi)} per million tokens.`}>
              {/* The median, drawn rather than only stated. A strip whose dots cluster at one
                  end and whose copy names a midpoint the picture does not mark reads as two
                  facts about different things — /market's ladder draws its mean for the same
                  reason. */}
              <line class="hp-strip-mid" x1={4 + (spX(spreadModel.price_in.median) / 100) * 392}
                    y1="6" x2={4 + (spX(spreadModel.price_in.median) / 100) * 392} y2="38" />
              <line class="hp-strip-axis" x1="4" y1="22" x2="396" y2="22" />
              {spDots.map((p: number) => (
                <circle class="hp-strip-dot" cx={4 + (spX(p) / 100) * 392} cy="22" r="4" />
              ))}
              {/* The dearest host is the finding, so it is the one mark that takes the ink. */}
              <circle class="hp-strip-dot hp-strip-dot--hi" cx="396" cy="22" r="6" />
            </svg>
            <div class="hp-strip-ends">
              <span>{usd(spLo)} per million</span>
              <span>{usd(spHi)} per million</span>
            </div>
          </div>
          <p class="hp-mod-note">
            The rule marks the middle of the market. Half of the companies serving this model
            charge under {priceWords(spreadModel.price_in.median)} per million tokens.
          </p>

          {/* Three short lines rather than two long ones: this column is the narrower of the
              two now, and "read several times a day" was breaking after "a". */}
          <p class="hp-mod-src">
            {market.totals.models_published} models &middot;
            {' '}{market.totals.host_endpoints} live endpoints
            <br />Read several times a day
            <br />Captured {stamp(market.captured_at)}
          </p>
          <p class="hp-mod-link">
            <a href="/market">Explore CanaryOne Market &rarr;</a>
          </p>
        </div>

        <!-- Module B — the workload. Three routes out of one run, lettered.
             THE DOMINANT ONE OF THE TWO, by a wider column, a stronger border and the one shadow
             in the section. Market intelligence says where to look and is public; this says what
             wins on the reader's own work, which is the half that is about them. Emphasis is the
             same pair § migration's middle stage uses for the same job — weight rather than colour,
             because a coloured card would be reading as a state. -->
        <div class="panel hp-mod hp-mod--lead">
          <p class="micro">WORKLOAD BENCHMARKING</p>
          <h3>The cheapest tokens can cost the most per finished task.</h3>
          <p class="hp-mod-sub">
            One workload, one model, {spell(run.totals.lanes)} routes. Three of them below, on
            identical tasks.
          </p>

          <div class="hp-routes-wrap">
          <table class="tm-data-table hp-routes">
            <caption class="sr-only">
              Three of the {run.totals.lanes} routes measured in run {runId}, showing attempts
              finished and cost per finished task.
            </caption>
            <thead>
              <tr>
                <th scope="col">Route</th>
                <th scope="col">Finished</th>
                <th scope="col">Cost per finished task</th>
              </tr>
            </thead>
            <tbody>
              {shown.map((l, i) => (
                <tr>
                  <th scope="row">{LETTERS[i]}</th>
                  <td>{l.passed} of {l.attempted}</td>
                  <td>{usd4(l.costPerPass)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          </div>

          <p class="hp-mod-src">
            {runBar}
            <br />Measured {day(run.startedAt)} &middot;
            {' '}<a href={DEMO_REPORT} target="_blank" rel="noopener">open the full report &rarr;</a>
          </p>
          <p class="hp-mod-link">
            <a href="/evals">Benchmark your workload &rarr;</a>
          </p>
        </div>
      </div>

      {/* CUT FROM SIX LINES TO THREE. Both caveats a skeptic would raise are still here, which
          is the number gate rather than an editorial choice: that the market half is advertised
          rather than measured, and that the routes are lettered because the magnitude reproduces
          and the name at either end does not. What went was the restatement around them. */}
      <div class="evidence">
        <p class="evidence-note">
          <strong>Two kinds of evidence.</strong> The market figure is what a host advertises,
          not a measurement of how well it serves the model. The route figures are one local run
          of our own tool, which is why they are lettered — the size of a gap like this repeats
          from run to run, and the name at either end does not.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── 5. MIGRATION ───
       REBUILT 2026-08-14. It was three large bordered cards in a row under the headline "You do
       not have to switch everything at once", closing on a paragraph explaining that none of it
       ships. Three problems, all of them structural: three boxes read as three products rather
       than one path, a planned capability took the same visual weight as the measured section
       above it, and the headline said what the reader does not have to do rather than what they
       do.

       One container now, three stages inside it, and the middle one carries the accent because
       it is the layer being introduced. THE STATUS IS ONE BADGE BESIDE THE EYEBROW rather than a
       paragraph at the foot: the hero already says the platform is in build, so restating it
       under every section was the page apologising for itself. PLANNED rather than IN BUILD, and
       the difference is COPY.md's — the three surfaces are being built, this is direction.

       Control first, migration second, and nothing here frames a company's existing providers as
       a mistake. -->
  <section class="section">
    <div class="container">
      <div class="sec-copy">
        <div class="hp-eyebrow">
          <p class="kicker">MOVE AT YOUR PACE</p>
          <span class="hp-status">Planned</span>
        </div>
        <h2>Move workload by workload.</h2>
        <p class="lede">
          Start with the models you already use. Add control and measurement first. Move a
          workload only when an open model proves the better choice.
        </p>
      </div>

      <div class="panel hp-mig">
        <div class="hp-mig-stage">
          <p class="micro">Today</p>
          <h3>Keep the models you already use</h3>
          <ul>
            <li>OpenAI and Anthropic</li>
            <li>existing integrations</li>
            <li>no model change required</li>
          </ul>
        </div>

        <p class="hp-mig-arrow" aria-hidden="true">&rarr;</p>

        <div class="hp-mig-stage hp-mig-stage--mid">
          <p class="micro">Through CanaryOne</p>
          <h3>Add control + measurement</h3>
          <ul>
            <li>one identity</li>
            <li>budgets + policy</li>
            <li>audit</li>
            <li>workload measurement</li>
          </ul>
        </div>

        <p class="hp-mig-arrow" aria-hidden="true">&rarr;</p>

        <div class="hp-mig-stage">
          <p class="micro">When one wins</p>
          <h3>Move one workload</h3>
          <ul>
            <li>open-weight model</li>
            <li>regional or specialised host</li>
            <li>only after it proves itself</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 6. YOUR COMPANY ───
       Four short modules across one row, each a label and one sentence. They were four tall
       cards in a two-by-two grid, each carrying a "We plan to" paragraph, closing on a
       disclaimer — which made the least concrete section on the page one of the tallest.

       The status is the same section-level badge § migration uses. The disclaimer that went with
       it named two things worth checking are still safe to lose: that we hold no compliance
       certification, which nothing here now implies because no certification, standard or
       acronym is mentioned; and the privacy formulation, which is a claim about the shipped tool
       and belongs on /evals, where it is. -->
  <section class="section">
    <div class="container">
      <div class="sec-copy">
        <div class="hp-eyebrow">
          <p class="kicker">YOUR COMPANY</p>
          <span class="hp-status">Planned</span>
        </div>
        <h2>Your knowledge. Your region. Your rules.</h2>
        <p class="lede">
          The four questions that decide whether a company can put a tool like this near its own
          documents at all.
        </p>
      </div>

      <div class="hp-cards hp-cards-4">
        <div class="panel hp-card hp-card--tight">
          <h3>Connect knowledge</h3>
          <p>Read from the systems where company information already lives.</p>
        </div>
        <div class="panel hp-card hp-card--tight">
          <h3>Carry permissions</h3>
          <p>Carry the identity and permissions a company already has.</p>
        </div>
        <div class="panel hp-card hp-card--tight">
          <h3>Control policy &amp; spend</h3>
          <p>Set model access, spending limits and usage in one place.</p>
        </div>
        <div class="panel hp-card hp-card--tight">
          <h3>Choose where it runs</h3>
          <p>Choose the region and infrastructure the workloads run on.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 7. EVIDENCE ───
       The compact enterprise-depth section, and the one place on the page where shipped and
       planned sit in the same object — so they get a status column rather than a hedge. The
       object is the artefact the measurement layer already produces. -->
  <section class="section">
    <div class="container">
      <div class="sec-copy">
        <p class="kicker">WHEN YOU NEED EVIDENCE</p>
        <h2>Simple for users. Inspectable when it matters.</h2>
        <p class="lede">
          A buyer who has to justify the choice should be able to see the working. The
          measurement layer is the part of this that already exists, and every run it does writes
          an artefact you can open.
        </p>
      </div>

      <div class="panel hp-shot">
        <div class="hp-shot-bar">
          <p class="micro hp-shot-id">{runBar}</p>
          <a href={DEMO_REPORT} target="_blank" rel="noopener">Open example report &rarr;</a>
        </div>
        <div class="hp-shot-body">
          <Image src={viewLeaderboard} widths={[760, 1100, viewLeaderboard.width]}
                 sizes="min(1100px, 88vw)" loading="lazy" class="hp-shot-img"
                 alt="A CanaryOne report: one row per route, with attempts finished, cost per finished task, judge score and latency percentiles beside each other." />
        </div>
      </div>

      <dl class="hp-proof">
        <div>
          <dt>Workload benchmarking</dt>
          <dd class="hp-status">Today</dd>
          <dd>Run it on your own repository and get one row per route.</dd>
        </div>
        <div>
          <dt>Route and model evidence</dt>
          <dd class="hp-status">Today</dd>
          <dd>Every figure on this site carries its date and links to the run behind it.</dd>
        </div>
        <div>
          <dt>Audit and policy record</dt>
          <dd class="hp-status">Planned</dd>
          <dd>Part of the admin surface we&rsquo;re building.</dd>
        </div>
        <div>
          <dt>Regional and host choice</dt>
          <dd class="hp-status">Planned</dd>
          <dd>Part of the model layer we&rsquo;re building.</dd>
        </div>
      </dl>

      <div class="evidence">
        <p class="evidence-src">
          The report is one static file, written to
          {' '}<code>&lt;repo&gt;/.c1/runs/&lt;runId&gt;/report/index.html</code>, so it opens
          from disk and travels in a pull request.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── 8. CLOSE ───
       One button and one link. .btn.ghost is a dark-surface component, so the second action here
       is a text link rather than a second button. -->
  <section class="section hp-close">
    <div class="container">
      <div class="hp-close-inner">
        <h2>Stop assembling your AI stack.</h2>
        <p class="lede">
          Start with the models and the tools you already use. We&rsquo;re building one place for
          a company to use them, control them, and improve what runs underneath.
        </p>
        <div class="hp-close-ctas">
          <a class="btn primary" href="#waitlist">Get early access &rarr;</a>
          <a class="hp-close-alt" href="/evals">Benchmark your workload &rarr;</a>
        </div>
        <p class="hp-close-links">
          <a href="/market">Market</a> &middot;
          <a href="/evals">Benchmarking</a> &middot;
          <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Only what global.css has no equivalent for. The section shell, the buttons, the table, the
     panel surface, the evidence footer and every label on this page are existing primitives.
     Scoped rather than global: the live index.astro publishes its hero layout with
     `is:global`, and two home pages fighting over `.hero__inner` is a promotion-day bug. */

  /* ---- hero ---- */
  /* The copy holds the lede measure; the diagram below it runs the full container. */
  .hp-hero-copy { max-width: var(--measure-lede); }
  .hp-trust {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted-on-dark);
    margin: var(--space-6) 0 0;
  }

  /* ---- the system object ----
     ONE OBJECT IN THREE PARTS: the three surfaces, the layer they converge on, and the purchase
     that replaces. It lived in the hero on a dark surface until 2026-08-14 and moved down into
     the section that makes the claim it illustrates, which is why the palette below is cream
     rather than near-black.

     HTML and CSS, for the reason /evals builds its fan-out the same way: the only geometry is a
     few hairlines, and a grid reflows on a phone where an 800-unit viewBox needs a sideways
     swipe. The wrapper carries the copy-to-object gap, so the parts inside it can sit on their
     own rhythm. */
  .hp-system { margin-top: var(--space-12); }

  /* Three surfaces converging on one layer. Percentages rather than lengths, because each tick
     has to land on the centre of its own column whatever the container is doing. */
  .hp-bus { position: relative; height: var(--space-10); }
  .hp-bus-tick,
  .hp-bus-line,
  .hp-bus-drop {
    position: absolute;
    background: var(--line-strong);
  }
  .hp-bus-tick { top: 0; height: 50%; width: 1px; }
  /* A third of the row is NOT a sixth of the container once the grid has a gap between its
     columns. At a 20px gap the first card's centre sits at 16.04% rather than 16.667%, so flat
     percentages left every tick about eight pixels inside the card it belongs to — visible, and
     the kind of near-miss that reads as a rendering fault rather than as a decision. The calc is
     the column centre exactly, and it follows --space-5 if the grid's gap ever changes. */
  .hp-bus-tick--l,
  .hp-bus-line { left: calc((100% - 2 * var(--space-5)) / 6); }
  .hp-bus-tick--c { left: 50%; }
  .hp-bus-tick--r { left: calc(100% - (100% - 2 * var(--space-5)) / 6); }
  .hp-bus-line { top: 50%; right: calc((100% - 2 * var(--space-5)) / 6); height: 1px; }
  .hp-bus-drop { top: 50%; bottom: 0; left: 50%; width: 1px; }

  /* The one yellow in the section, and on cream it may only be a wash sitting behind content
     that keeps its own colour — which is exactly what --accent-bg is for, and what the /market
     price ladder's hovered row and the /evals winner row already use it for. On the dark hero
     this band was a yellow hairline plus a 4% wash; neither survives the move, because
     --accent-deep on cream measures 1.87:1 and a 4% yellow on cream is invisible. THE LABEL IS
     INK, NOT CANARY, for the same reason. */
  .hp-core {
    background: var(--accent-bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    text-align: center;
  }
  .hp-core-label { color: var(--text); margin-bottom: var(--space-3); }
  /* The lockup, held well back from the tiles below it. Block plus auto margins rather than a
     text-align inherit, so it centres on its own box whatever the label above it is doing. */
  .hp-core-mark {
    display: block;
    width: 120px;
    height: 22px;
    margin: 0 auto var(--space-6);
  }

  /* Four tiles, not a line of words. White on the wash, so each capability reads as a module
     inside the layer rather than as text printed on it. Left-aligned inside their own boxes
     while the identity above stays centred — a centred label beside an icon leaves a ragged
     gap between the two. */
  .hp-core-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    text-align: left;
  }
  .hp-core-items > li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
  }
  /* The icons sit back so the typography leads, which is the whole brief for them. */
  .hp-core-items svg {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
    color: var(--muted);
  }

  /* The packaging thesis, as one line rather than a diagram or a two-row list. The two halves
     take different weight instead of different colour: the count on the left is the situation
     and the phrase on the right is the answer, so the answer takes the ink. */
  .hp-contrast {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted);
    margin: var(--space-6) 0 0;
    text-align: center;
  }
  .hp-contrast-arrow { margin: 0 var(--space-2); }
  .hp-contrast-ours { color: var(--text); font-weight: var(--weight-semibold); }

  /* ---- card grids ----
     One card component at three widths. .panel carries the section's copy-to-object gap in its
     own top margin, which is wrong inside a grid — the grid owns the gap. */
  .hp-cards {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-12);
  }
  /* Inside the system object the wrapper owns that gap, and the cards sit at its top. */
  .hp-system > .hp-cards { margin-top: 0; }
  /* NOT TWO EQUAL HALVES. The workload module is the one about the reader's own work, so it
     takes the wider column; market intelligence is the public half and sits beside it. */
  .hp-cards-2 { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); }
  .hp-cards-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  /* Four across rather than two-by-two. As two rows of tall cards this was the least concrete
     section on the page and one of the tallest, which is the wrong way round. */
  .hp-cards-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .hp-cards > .panel { margin-top: 0; }
  .hp-card { padding: var(--space-8) var(--space-7); }
  /* A label and one sentence wants less room around it than a surface card does. */
  .hp-card--tight { padding: var(--space-6) var(--space-5); }
  .hp-card--tight h3 { font-size: var(--text-base); }
  .hp-card--tight p:last-child { font-size: var(--text-base); }
  /* The surface's name and its status on one line, so the chip reads as a property of the card
     rather than as a thing floating above it. Baseline-aligned: a chip hung off the top of a
     21px heading sits visibly high. */
  .hp-card-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }
  .hp-card h3 {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }
  .hp-card p:last-child {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--muted);
    margin: 0;
  }

  /* An eyebrow with its status beside it. The kicker's own bottom margin moves to the row, so
     the chip cannot push the heading down. */
  .hp-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }
  .hp-eyebrow .kicker { margin-bottom: 0; }

  /* ---- the status chip ----
     ONE COMPONENT, TWO USE SITES: "In build" on a surface card and "Today" or "Planned" in the
     evidence proof list. They were the same five declarations twice, which is how a site ends up
     with two chips that drift apart — and a status label is exactly the thing that must look the
     same everywhere or it stops being read as a status.

     Neutral rather than canary. On cream, yellow is legal as a fill behind dark text, but yellow
     means primary and selected everywhere else on this site, and a chip saying a thing does not
     exist yet is not the same message as a chip on a winning row. */
  .hp-status {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-full);
    padding: var(--space-0-5) var(--space-3);
    white-space: nowrap;
    flex: 0 0 auto;
  }

  /* ---- 4. intelligence ----
     The one tinted section on the page, because it is the one carrying figures. */
  .hp-intel { background: var(--bg-tint); }
  /* On the tint, a panel's own cream keeps the modules reading as objects on a surface. */
  .hp-mod { padding: var(--space-8) var(--space-7); display: flex; flex-direction: column; }
  .hp-mod--lead { border-color: var(--line-strong); box-shadow: var(--shadow-sm); }
  .hp-mod h3 {
    font-size: var(--display-md);
    font-weight: var(--weight-medium);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    margin: 0 0 var(--space-4);
  }
  .hp-mod-sub {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--muted);
    margin: 0 0 var(--space-6);
  }
  /* Pushed to the foot of the card so both modules' source lines sit on one line, whatever the
     object above them is. */
  .hp-mod-src {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--muted);
    margin: auto 0 0;
    padding-top: var(--space-5);
  }
  .hp-mod-src a { color: var(--text); border-bottom: 1px solid var(--line-strong); }
  .hp-mod-src a:hover { border-bottom-color: currentColor; }
  /* The sentence that reads the strip, at note weight rather than lede weight: it explains a
     mark, which is what .sec-note does for a chart in the section shell. */
  .hp-mod-note {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--muted);
    margin: var(--space-4) 0 0;
  }
  .hp-mod-link { margin: var(--space-4) 0 0; }
  .hp-mod-link a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
    border-bottom: 1px solid var(--line-strong);
  }
  .hp-mod-link a:hover { border-bottom-color: currentColor; }

  /* The price strip. One dot per host on a log axis, because the range is past tenfold and a
     linear axis piles every host but the dearest into the first tenth of the track. Two dot
     sizes and no third, matching /market: the dearest host is the finding and takes the ink,
     everything else recedes. */
  .hp-strip { margin: 0 0 var(--space-2); }
  .hp-strip svg { display: block; width: 100%; height: auto; overflow: visible; }
  .hp-strip-axis { stroke: var(--line-strong); stroke-width: 1; }
  .hp-strip-mid { stroke: var(--line-strong); stroke-width: 1; }
  .hp-strip-dot { fill: var(--muted); opacity: 0.5; }
  .hp-strip-dot--hi { fill: var(--text); opacity: 1; }
  .hp-strip-ends {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    margin-top: var(--space-2);
  }

  /* .tm-data-table, which right-aligns everything and left-aligns its row headers. Only the
     first column's width needs saying. */
  .hp-routes th[scope='row'] { width: 34%; }
  /* The table holds its width and its own wrapper scrolls, which is what .tm-table-scroll does
     for a wide table elsewhere. Every cell in the contract is nowrap, so without this the
     table's min-content width becomes the grid column's floor and the whole page scrolls
     sideways on a phone. */
  .hp-routes-wrap { overflow-x: auto; }

  /* ---- 5. migration ----
     ONE CONTAINER, THREE STAGES, NOT THREE CARDS. The panel's own border is the journey; the
     stages inside it have no boxes of their own, so they read as points on a path rather than as
     three things to buy. The middle stage is the exception, because it is the layer being
     introduced and the section's whole argument is that it arrives before any migration does. */
  .hp-mig {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    gap: var(--space-5);
    padding: var(--space-7) var(--space-6);
  }
  .hp-mig-stage { min-width: 0; }
  /* The accent, as a wash behind content that keeps its own colour — the one form yellow takes
     on cream besides a fill behind dark text. Subtle on purpose: this stage is the strongest of
     the three, not a callout. The negative margin lets the wash sit inside the panel's padding
     without the other two stages having to be padded to match. */
  .hp-mig-stage--mid {
    background: var(--accent-bg);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    margin: calc(-1 * var(--space-4)) 0;
  }
  .hp-mig-stage h3 {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--text);
    margin: 0 0 var(--space-3);
  }
  .hp-mig-stage ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }
  .hp-mig-stage li {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    color: var(--muted);
  }
  /* Ornament inside a diagram, which is where COPY.md allows an arrow a place of its own. It
     sits against the stage titles rather than centred in the row, so the three stages read left
     to right along one line instead of the arrows floating in the middle of unequal blocks. */
  .hp-mig-arrow {
    align-self: start;
    margin: var(--space-6) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--muted);
  }

  /* ---- 7. evidence ---- */
  .hp-shot { margin-top: var(--space-12); }
  .hp-shot-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--line);
    background: var(--bg-tint);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }
  .hp-shot-id { margin: 0; }
  .hp-shot-bar a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text);
    border-bottom: 1px solid var(--line-strong);
    white-space: nowrap;
  }
  .hp-shot-bar a:hover { border-bottom-color: currentColor; }
  /* The crop holds its width and the panel scrolls, for the reason /evals' report views do: a
     nine-column table squeezed into a phone is not a smaller image, it is an unreadable one. */
  .hp-shot-body { padding: var(--space-5); overflow-x: auto; }
  .hp-shot-img {
    display: block;
    width: 100%;
    min-width: var(--chart-min);
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }

  /* Four proof points, with the status in a column of its own rather than hedged into the
     sentence beside it. */
  .hp-proof { margin: var(--space-8) 0 0; display: grid; gap: var(--space-3); }
  .hp-proof > div {
    display: grid;
    grid-template-columns: minmax(0, var(--col-label)) auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .hp-proof > div:last-child { border-bottom: 0; padding-bottom: 0; }
  .hp-proof dt, .hp-proof dd { margin: 0; font-size: var(--text-sm); }
  .hp-proof dt { font-family: var(--font-mono); color: var(--text); }
  .hp-proof dd { color: var(--muted); }
  /* .hp-status, in a grid cell rather than a flex row. The chip itself is declared once above. */

  /* ---- 8. close ---- */
  .hp-close { background: var(--bg-tint); text-align: center; }
  .hp-close-inner { max-width: var(--measure-prose); margin: 0 auto; }
  .hp-close h2 { margin-inline: auto; }
  .hp-close .lede { margin: 0 auto var(--space-10); }
  .hp-close-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-6);
  }
  /* A link rather than a second button: .btn.ghost is a dark-surface component and this section
     is cream. */
  .hp-close-alt {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
    border-bottom: 1px solid var(--line-strong);
  }
  .hp-close-alt:hover { border-bottom-color: currentColor; }
  .hp-close-links {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    margin: var(--space-10) 0 0;
  }
  .hp-close-links a { color: var(--muted); }
  .hp-close-links a:hover { color: var(--text); }

  /* LAST IN THE BLOCK, because these override base rules of equal specificity and source order
     decides. A media query placed above them does nothing at all. */
  @media (max-width: 900px) {
    /* The diagram simplifies rather than scrolling: the three surfaces stack, so the converging
       bus becomes one straight line down. */
    .hp-bus { height: var(--space-8); }
    .hp-bus-tick--l, .hp-bus-tick--r, .hp-bus-line { display: none; }
    .hp-bus-tick--c { height: 100%; }
    /* Four tiles need about 200px each for their label; two across is the widest that holds. */
    .hp-core-items { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hp-cards-2, .hp-cards-3 { grid-template-columns: minmax(0, 1fr); }
    /* Stacked, the contrast line breaks badly around its arrow. */
    .hp-contrast-arrow { display: block; }
    /* The journey goes vertical and its arrows turn with it. The middle stage keeps its wash,
       so the path is still readable as one thing with a highlighted middle. */
    .hp-mig { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
    .hp-mig-arrow { margin: 0; text-align: center; transform: rotate(90deg); }
    .hp-mig-stage--mid { margin: 0; }
    /* Four across needs the width; halved here and stacked at 640, which is what the
       breakpoint table says a dense grid does. */
    .hp-cards-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .hp-cards-4 { grid-template-columns: minmax(0, 1fr); }
    /* The status label and its sentence stack rather than sharing three fixed columns. */
    .hp-proof > div { grid-template-columns: minmax(0, 1fr); gap: var(--space-2); }
    .hp-proof .hp-status { justify-self: start; }
    /* The verdict drops under its label rather than sharing a fixed first column. */
    .hp-contrast > div { grid-template-columns: minmax(0, 1fr); gap: var(--space-1); }
    .hp-core-items { grid-template-columns: minmax(0, 1fr); }
  }
</style>
