---
import '../styles/global.css';

const GITHUB_URL = 'https://github.com/rupulsafaya/canaryone';
const TWITTER_URL = 'https://twitter.com/CanaryOneOSS';
const TWITTER_HANDLE = '@CanaryOneOSS';
const SITE_URL = 'https://canaryone.ai';
const TITLE = 'CanaryOne — test AI providers on your own test workloads';
const DESCRIPTION = 'Points CanaryOne at your repo, runs your tests against every provider, reports real cost and quality — not a leaderboard.';

const routers = [
  { name: 'OpenRouter', file: 'openrouter.svg' },
  { name: 'Vercel AI Gateway', file: 'vercel.svg' },
  { name: 'AWS Bedrock', file: 'bedrock.svg' },
];

const directA = [
  { name: 'Moonshot', file: 'moonshot.svg' },
  { name: 'Nebius', file: 'nebius.svg' },
  { name: 'Fireworks', file: 'fireworks.svg' },
  { name: 'Together', file: 'together.svg' },
];

const directB = [
  { name: 'Baseten', file: 'baseten.svg' },
  { name: 'Groq', file: 'groq.svg' },
  { name: 'DeepSeek', file: 'deepseek.svg' },
  { name: 'Cerebras', file: 'cerebras.svg' },
];

const scoreboard = [
  { model: 'Kimi K3', provider: 'Moonshot AI', via: 'OpenRouter',  pass: '12/12', cost: '$0.1852', traj: '88', winner: false, narrator: false, star: false },
  { model: 'Kimi K3', provider: 'Fireworks',   via: 'Vercel',      pass:  '9/12', cost: '$0.0921', traj: '86', winner: true,  narrator: false, star: true },
  { model: 'Kimi K3', provider: 'baseten',     via: 'Vercel',      pass: '11/12', cost: '$0.0967', traj: '84', winner: false, narrator: false, star: false },
  { model: 'Kimi K3', provider: 'moonshot-intl', via: 'direct',    pass:  '9/12', cost: '$0.0686', traj: '87', winner: false, narrator: false, star: false },
  { model: 'Kimi K3', provider: 'nebius',      via: 'Vercel',      pass:  '6/12', cost: '$0.0472', traj: '69 ⚠', winner: false, narrator: true, star: false },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={SITE_URL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:image" content={`${SITE_URL}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={SITE_URL} />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE_URL}/og.png`} />

    <meta name="theme-color" content="#0f0f10" />
  </head>
  <body>
    <nav class="topnav">
      <div class="container inner">
        <a class="wordmark" href="/" aria-label="CanaryOne home">
          <span class="dot" aria-hidden="true"></span>
          <span><span class="canary">Canary</span>One</span>
        </a>
        <div class="links">
          <a href={GITHUB_URL}>github</a>
          <a href={TWITTER_URL}>{TWITTER_HANDLE}</a>
        </div>
      </div>
    </nav>

    <section class="hero">
      <div class="container">
        <h1>
          Test AI providers on<br />
          <span class="em">your own test workloads</span>.
        </h1>

        <p class="sub">
          Points at your repo. Runs your tests against every provider you
          could ship on. Results specific to your workload — not a leaderboard
          someone else built.
        </p>

        <div class="ctas">
          <a class="btn primary" href={GITHUB_URL}>
            View on GitHub  →
          </a>
          <a class="btn ghost" href="#install" aria-label="Jump to install">
            <span>$&nbsp;npx&nbsp;canaryone</span>
          </a>
        </div>

        <div class="receipt">
          <div class="receipt-frame" id="receipt-frame" role="button" tabindex="0" aria-label="Enlarge receipt image">
            <img
              src="/receipt-kimi-k3.png"
              alt="canaryone running Kimi K3 across 10 routes — 3.9× cost spread, one route silently narrating"
              loading="eager"
              decoding="async"
            />
          </div>
          <p class="receipt-caption">
            Kimi K3 · 10 routes · launch day · 3.9× cost spread · one narrator <span class="warn">⚠</span>
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="kicker">01 · COVERAGE</p>
        <h2>Every router.<br />Every direct provider.</h2>
        <p class="lede">
          CanaryOne benchmarks the same model across three routers plus nine
          direct provider APIs — every route your production traffic could take.
        </p>

        <div class="hub" id="hub">
          <svg id="hub-lines" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"></svg>

          <div class="hub-row routers">
            {routers.map((r) => (
              <div class="hub-card" data-node="router" data-label={r.name}>
                <img src={`/logos/${r.file}`} alt={r.name} title={r.name} width="120" height="26" />
              </div>
            ))}
          </div>

          <div class="hub-center" data-node="center">
            <div class="core">
              <span class="glyph" aria-hidden="true">c</span>
              <span>CanaryOne</span>
            </div>
          </div>

          <div class="hub-row direct-a">
            {directA.map((p) => (
              <div class="hub-card small" data-node="direct" data-label={p.name}>
                <img src={`/logos/${p.file}`} alt={p.name} title={p.name} width="100" height="22" />
              </div>
            ))}
          </div>

          <div class="hub-row direct-b">
            {directB.map((p) => (
              <div class="hub-card small" data-node="direct" data-label={p.name}>
                <img src={`/logos/${p.file}`} alt={p.name} title={p.name} width="100" height="22" />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="kicker">02 · THE ROUTE MATTERS</p>
        <h2><span class="em">3.9×</span> cost spread<br />on the identical model.</h2>
        <p class="lede">
          Same model. Different routes. Different answers. Two lanes even
          silently narrated instead of doing the work. CanaryOne lets you pick
          the cheapest <em>grounded</em> lane, not the cheapest lane.
        </p>

        <div class="scoreboard" role="table" aria-label="Kimi K3 launch day results">
          <table>
            <thead>
              <tr>
                <th>Route</th>
                <th class="num">Pass</th>
                <th class="num">$/pass</th>
                <th class="num">Trajectory</th>
              </tr>
            </thead>
            <tbody>
              {scoreboard.map((row) => (
                <tr class={`${row.winner ? 'winner' : ''} ${row.narrator ? 'narrator' : ''}`}>
                  <td>
                    {row.provider} <span class="via">· {row.via}</span>
                    {row.star && <span class="star" aria-label="best weighted $/pass"> ★</span>}
                  </td>
                  <td class="num">{row.pass}</td>
                  <td class="num">{row.cost}</td>
                  <td class="num">{row.traj}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="kicker">03 · LOCAL</p>
        <h2>Nothing leaves<br />your machine.</h2>
        <p class="lede">
          API keys sit in <code>~/.c1/.env</code> at mode <code>0600</code>. The
          proxy runs on localhost. Reports are static HTML files under
          <code>&lt;repo&gt;/.c1/runs/</code>. The only outbound traffic goes to
          the LLM providers you configured.
        </p>

        <div class="boundary">
          <div class="row">
            <div class="node">
              your app
              <span class="sub">tests + eval harness</span>
            </div>
            <span class="arrow" aria-hidden="true">→</span>
            <div class="node">
              localhost:port
              <span class="sub">per-lane proxy</span>
            </div>
            <span class="arrow" aria-hidden="true">→</span>
            <div class="node">
              ~/.c1/runs
              <span class="sub">sqlite + report</span>
            </div>
          </div>

          <div class="egress">
            <span class="kv">outbound →</span>
            configured LLM providers only
          </div>
        </div>
      </div>
    </section>

    <section class="section report-section">
      <div class="container">
        <p class="kicker">04 · THE REPORT</p>
        <h2>A static HTML report,<br />dropped in your repo.</h2>
        <p class="lede">
          Every run writes a self-contained <code>report/index.html</code> under
          <code>&lt;repo&gt;/.c1/runs/&lt;runId&gt;/</code>. Leaderboard cards,
          lane table, heatmap, session drilldown — no dashboard, no login, no
          cloud.
        </p>

        <a class="report-frame" href="/demo-report/index.html" target="_blank" rel="noopener" aria-label="Open the full demo report">
          <div class="report-toolbar">
            <span class="dot r"></span>
            <span class="dot y"></span>
            <span class="dot g"></span>
            <span class="path">/.c1/runs/e860167a/report/index.html</span>
            <span class="open">open full report →</span>
          </div>
          <div class="report-shots">
            <figure class="shot">
              <img
                src="/report-leaderboard.png"
                alt="CanaryOne report leaderboard — Best Value, Cheapest Raw, Pass Rate, Total Spend."
                loading="lazy"
                width="2438"
                height="1034"
              />
              <figcaption>Leaderboard — every lane, ranked by weighted $/pass.</figcaption>
            </figure>
            <figure class="shot">
              <img
                src="/report-heatmap.png"
                alt="CanaryOne report heatmap — pass/fail per lane × task."
                loading="lazy"
                width="1772"
                height="1200"
              />
              <figcaption>Heatmap — every lane × task cell, at a glance.</figcaption>
            </figure>
          </div>
        </a>
      </div>
    </section>

    <section class="section install" id="install">
      <div class="container">
        <p class="kicker">GET STARTED</p>
        <h2>One command.</h2>

        <div class="terminal">
          <div class="terminal-bar" aria-hidden="true">
            <span class="dot r"></span>
            <span class="dot y"></span>
            <span class="dot g"></span>
            <span class="label">~/your-repo</span>
          </div>
          <div class="terminal-body">
            <span class="prompt">$</span>
            <code id="install-cmd">npx canaryone</code>
            <button class="copy" id="copy-btn" type="button" aria-label="Copy command">copy</button>
          </div>
        </div>

        <p class="hint">
          Point it at any repo whose tests call an LLM.
          See the <a href={GITHUB_URL}>README</a> for the walk-through.
        </p>
      </div>
    </section>

    <section class="status">
      <div class="container">
        <p>
          v0.1 in development. Bugs, provider adds, and reproducible failure
          patterns welcome as issues.
        </p>
      </div>
    </section>

    <footer class="footer">
      <div class="container" style="display: flex; gap: 24px; width: 100%; align-items: center;">
        <a href={GITHUB_URL}>github</a>
        <a href={TWITTER_URL}>{TWITTER_HANDLE}</a>
        <span class="spacer"></span>
        <span>MIT</span>
      </div>
    </footer>

    <div class="lightbox" id="lightbox" aria-hidden="true">
      <img src="/receipt-kimi-k3.png" alt="" />
    </div>

    <script is:inline>
      (function () {
        // ---------- Copy button ----------
        const btn = document.getElementById('copy-btn');
        const cmd = document.getElementById('install-cmd');
        if (btn && cmd) {
          btn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(cmd.textContent.trim());
              btn.textContent = 'copied';
              btn.classList.add('copied');
              setTimeout(() => {
                btn.textContent = 'copy';
                btn.classList.remove('copied');
              }, 1600);
            } catch (e) {
              btn.textContent = 'select all';
              const sel = window.getSelection();
              const range = document.createRange();
              range.selectNodeContents(cmd);
              sel.removeAllRanges();
              sel.addRange(range);
              setTimeout(() => (btn.textContent = 'copy'), 2000);
            }
          });
        }

        // ---------- Lightbox ----------
        const frame = document.getElementById('receipt-frame');
        const lightbox = document.getElementById('lightbox');
        const openLightbox = () => {
          lightbox.classList.add('open');
          lightbox.setAttribute('aria-hidden', 'false');
        };
        const closeLightbox = () => {
          lightbox.classList.remove('open');
          lightbox.setAttribute('aria-hidden', 'true');
        };
        if (frame && lightbox) {
          frame.addEventListener('click', openLightbox);
          frame.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openLightbox(); }
          });
          lightbox.addEventListener('click', closeLightbox);
          document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });
        }

        // ---------- Hub-and-spoke connectors ----------
        const hub = document.getElementById('hub');
        const svg = document.getElementById('hub-lines');
        if (hub && svg && window.matchMedia('(min-width: 640px)').matches) {
          const draw = () => {
            const cards = hub.querySelectorAll('.hub-card');
            const center = hub.querySelector('.hub-center .core');
            if (!center || !cards.length) return;

            const hubRect = hub.getBoundingClientRect();
            svg.setAttribute('viewBox', `0 0 ${hubRect.width} ${hubRect.height}`);
            svg.setAttribute('width', hubRect.width);
            svg.setAttribute('height', hubRect.height);

            const c = center.getBoundingClientRect();
            const cx = c.left + c.width / 2 - hubRect.left;
            const cy = c.top + c.height / 2 - hubRect.top;

            let paths = '';
            cards.forEach((card) => {
              const r = card.getBoundingClientRect();
              const rx = r.left + r.width / 2 - hubRect.left;
              const ry = r.top + r.height / 2 - hubRect.top;

              // Anchor to nearest edge of the card (top or bottom) so lines don't overlap the label.
              const anchorY = ry < cy ? r.bottom - hubRect.top : r.top - hubRect.top;
              // Anchor to nearest edge of the hub (top or bottom).
              const hubY = ry < cy ? c.top - hubRect.top : c.bottom - hubRect.top;

              // Curved cubic path: start at card, control points bend toward the hub.
              const midY = (anchorY + hubY) / 2;
              paths += `<path d="M ${rx} ${anchorY} C ${rx} ${midY}, ${cx} ${midY}, ${cx} ${hubY}" />`;
            });
            svg.innerHTML = paths;
          };
          const rafDraw = () => requestAnimationFrame(draw);
          rafDraw();
          window.addEventListener('resize', rafDraw, { passive: true });
          // Redraw after fonts + images settle
          window.addEventListener('load', () => setTimeout(rafDraw, 50));
          if (typeof ResizeObserver !== 'undefined') {
            const ro = new ResizeObserver(rafDraw);
            ro.observe(hub);
          }
        }
      })();
    </script>
  </body>
</html>
