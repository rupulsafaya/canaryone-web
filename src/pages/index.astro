  }

  /* ---- 8. close ---- */
  .hp-close { background: var(--bg-tint); text-align: center; }
  .hp-close-inner { max-width: var(--measure-prose); margin: 0 auto; }
  .hp-close h2 { margin-inline: auto; }
  .hp-close .lede { margin: 0 auto var(--space-10); }
  .hp-close-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-6);
  }
  /* A link rather than a second button: .btn.ghost is a dark-surface component and this section
     is cream. */
  .hp-close-alt {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
    border-bottom: 1px solid var(--line-strong);
  }
  .hp-close-alt:hover { border-bottom-color: currentColor; }
  .hp-close-links {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    margin: var(--space-10) 0 0;
  }
  .hp-close-links a { color: var(--muted); }
  .hp-close-links a:hover { color: var(--text); }

  /* LAST IN THE BLOCK, because these override base rules of equal specificity and source order
     decides. A media query placed above them does nothing at all. */
  @media (max-width: 900px) {
    /* The diagram simplifies rather than scrolling: the three surfaces stack, so the converging
       bus becomes one straight line down. */
    .hp-surfaces { grid-template-columns: minmax(0, 1fr); }
    .hp-bus { height: var(--space-8); }
    .hp-bus-tick--l, .hp-bus-tick--r, .hp-bus-line { display: none; }
    .hp-bus-tick--c { height: 100%; }
    .hp-cards-2, .hp-cards-3 { grid-template-columns: minmax(0, 1fr); }
    /* Five rows beside one block needs the width; stacked, the arrow turns to point down. */
    .hp-swap { grid-template-columns: minmax(0, 1fr); }
    .hp-swap-arrow { text-align: center; transform: rotate(90deg); }
    .hp-flow { grid-template-columns: minmax(0, 1fr); }
    .hp-flow-arrow { margin: 0; text-align: center; transform: rotate(90deg); }
  }
  @media (max-width: 640px) {
    .hp-cards-4 { grid-template-columns: minmax(0, 1fr); }
    /* The status label and its sentence stack rather than sharing three fixed columns. */
    .hp-proof > div { grid-template-columns: minmax(0, 1fr); gap: var(--space-2); }
    .hp-proof-when { justify-self: start; }
    .hp-core-items { gap: var(--space-2) var(--space-4); }
  }
</style>
