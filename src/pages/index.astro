---
/**
 * / — the home page.
 *
 * TOOK THE ROUTE ON 2026-08-14, replacing the flywheel page that had held it since the site was
 * repositioned onto the four pillars. That page is not in git history alone: it is kept whole at
 * archive/home-flywheel.astro, which is outside src/pages/ and therefore not built and not
 * served. Restoring it is one `git mv` back — see its own header.
 *
 * WHY IT CHANGED. The old page sold the four pillars of a command-line tool — Test, Tune, Deploy,
 * Improve. The company those pillars belong to is described in Strategy/AIBOX-VISION.md in
 * fantastic-dollop, and it is a packaged AI stack rather than an eval tool. This page is the
 * first expression of that, and it is built to be understood by a visitor who never learns the
 * words routing, RAG, eval or open-weight. The benchmarking tool is still here; it is the
 * measurement layer underneath the model shelf rather than the whole company.
 *
 * THE REGISTER IS THE HARD PART, AND IT IS WHY THIS PAGE READS THE WAY IT DOES. Almost nothing in
 * the vision ships. What ships is the benchmarking CLI, the free daily market capture and the
 * paid nightly sweep. COPY.md § The three registers says the status belongs in the sentence
 * rather than in a nearby button, and that describing a mechanism implies it exists — so every
 * unbuilt surface on this page is written as "we're building" or "we plan to", and no unbuilt
 * mechanism is specified. The measurement sections are the only ones in the present indicative,
 * which is also what makes them do the credibility work the page needs them to do.
 *
 * EVERY FIGURE IS GENERATED, none typed. The market half comes from src/data/market.json and the
 * workload half from src/data/example-run.json, which are the same two payloads /market and
 * /evals read. The three routes in § intelligence are selected by the same rule /evals uses —
 * cheapest, cheapest-that-finished-most, most-finished — so the two pages cannot tell different
 * stories about one run.
 *
 * TWO DEPARTURES FROM THE BRIEF IT WAS BUILT FROM, both deliberate:
 *
 *   THE STACK SECTION DOES NOT REDRAW THE HERO DIAGRAM. The brief asked for a surfaces-to-layer
 *   composite in the hero and a layered architecture diagram in § the stack. Drawn twice that is
 *   one claim in two formats, which the brief's own visual-density rule rules out. The hero
 *   carries the diagram; § the stack carries the thing the diagram cannot show, which is the
 *   five separate purchases it replaces.
 *
 *   THE CTAs ARE "GET EARLY ACCESS" AND THE INSTALL LINE, not "Get started" and "Talk to us".
 *   There is no sign-up and no contact address on this site; the waitlist dialog in Layout.astro
 *   is the only mechanism either button could reach, and two buttons opening one dialog is worse
 *   than one. The ghost button sends a technical reader to the thing that does exist.
 *
 * NO CLIENT JAVASCRIPT AND NO ANIMATION. This page removed the site's one looping animation with
 * the flywheel, so the site now has none — DESIGN.md § Motion was rewritten to say so rather than
 * left describing a page that is no longer served.
 *
 * STILL OPEN, and deliberately not decided here: Strategy/positioning.md and Strategy/concept.md
 * in fantastic-dollop describe the CLI-only company. COPY.md says positioning.md is the source
 * every sentence on this site inherits from, so it is now behind the front door rather than
 * ahead of it, and that is a gap to close rather than a state to keep.
 */
import { Image } from 'astro:assets';
import Layout, { GITHUB_URL } from '../layouts/Layout.astro';
import market from '../data/market.json';
import run from '../data/example-run.json';
import viewLeaderboard from '../assets/report-view-leaderboard.png';
import { spell, mult, day, stamp, usd, usd4, priceWords } from '../lib/prose';

const TITLE = 'CanaryOne — your company’s AI stack, without the assembly';
const DESCRIPTION =
  'We’re building one place for a company to use AI — chat, company knowledge, coding and API access — over a model layer we measure every night. Start with the models you already use.';

const DEMO_REPORT = run.reportUrl;

/* ---------------------------------------------------------------------------
   § INTELLIGENCE, module A — the market.

   The widest listed price spread on the board, found rather than hand-picked, so a re-generated
   payload cannot leave the headline pointing at a model whose spread has since closed. Only
   open-weight models with more than one host can have a spread at all.
   --------------------------------------------------------------------------- */
const spreadModel = market.models
  .filter((x: any) => x.open_weights && x.price_in && x.price_in.n > 1)
  .sort((a: any, b: any) => b.price_in.ratio - a.price_in.ratio)[0];

const spLo = spreadModel.price_in.min;
const spHi = spreadModel.price_in.max;
/* Logarithmic, for the reason /market's ladder is: the range is past tenfold, and on a linear
   axis every host but the dearest piles into the leftmost tenth of the track. */
const lg = (v: number) => Math.log10(v);
const spX = (v: number) => ((lg(v) - lg(spLo)) / (lg(spHi) - lg(spLo))) * 100;
/* One dot per host that reports a price. The scatter is one short of hosts_listed, so the count
   in the copy is the scatter's own length rather than the listing count — a strip with nineteen
   dots under the word twenty is the kind of small wrongness a technical reader stops on. */
const spDots = [...spreadModel.scatter]
  .map((s: any) => s.price)
  .filter((p: number) => p != null)
  .sort((a: number, b: number) => a - b);

/* ---------------------------------------------------------------------------
   § INTELLIGENCE, module B — the workload.

   The same three routes /evals shows, selected by the same rule so the two pages cannot disagree
   about one run: the cheapest route, the cheapest route that finished most of the work, and the
   route that finished all of it. Lettered by cost, cheapest first — COPY.md § Naming a host: a
   single local run cannot carry company names, and the report one click away names all ten.
   --------------------------------------------------------------------------- */
type Lane = (typeof run.lanes)[number];
const byCost = (a: Lane, b: Lane) => a.costPerPass - b.costPerPass;
const RELIABLE = 0.75;

const cheapest = [...run.lanes].sort(byCost)[0];
const reliable = [...run.lanes]
  .filter((l) => l.passed / l.attempted >= RELIABLE && l.slug !== cheapest.slug)
  .sort(byCost)[0];
const complete = [...run.lanes]
  .filter((l) => l.slug !== cheapest.slug && l.slug !== reliable.slug)
  .sort((a, b) => b.passed - a.passed || a.costPerPass - b.costPerPass)[0];

const shown = [cheapest, reliable, complete].sort(byCost);
const LETTERS = ['Route A', 'Route B', 'Route C'];

const runId = run.runId.split('-')[0];
const runBar = [`run ${runId}`, `${run.totals.lanes} routes`, `${run.totals.tasks} tasks`,
  `${run.totals.repeats} repeats each`].join(' · ');
---

<Layout title={TITLE} description={DESCRIPTION} path="/">
  <!-- ─── HERO ───
       The company in one sentence, then the shape of the system underneath it. The diagram sits
       below the copy at full width rather than beside it: three surfaces across the top need the
       room, and half a hero column turns them into three cramped columns. -->
  <section class="hero">
    <div class="container">
      <div class="hp-hero-copy">
        <p class="kicker">CANARYONE</p>
        <h1>Your company&rsquo;s AI stack, <span class="em">without the assembly.</span></h1>
        <p class="sub">
          Most companies end up buying a chat tool, a knowledge tool, a coding assistant, a
          gateway and an admin console from five different vendors, then gluing them together.
          We&rsquo;re building the box those five should have come in, over a model layer we
          measure every night.
        </p>
        <div class="ctas">
          <a class="btn primary" href="#waitlist">Get early access &rarr;</a>
          <a class="btn ghost" href="/evals#install">
            <span>$&nbsp;npx&nbsp;canaryone</span>
          </a>
        </div>
        <p class="hp-trust">
          The benchmarking tool ships today &middot; the platform is in build &middot; every
          figure on this site links to the run behind it
        </p>
      </div>

      <!-- Many needs, one system, many models. Pure HTML and CSS: the only geometry is a
           handful of hairlines, and a grid reflows on a phone where a viewBox needs a swipe. -->
      <div class="hp-stack" aria-label="How CanaryOne is put together">
        <p class="micro hp-stack-cap">What people need</p>
        <div class="hp-surfaces">
          <div class="hp-surface">
            <p class="hp-surface-name">Ask</p>
            <p class="hp-surface-sub">chat and company knowledge</p>
          </div>
          <div class="hp-surface">
            <p class="hp-surface-name">Build</p>
            <p class="hp-surface-sub">coding and API access</p>
          </div>
          <div class="hp-surface">
            <p class="hp-surface-name">Control</p>
            <p class="hp-surface-sub">people, budgets, policy, audit</p>
          </div>
        </div>

        <div class="hp-bus" aria-hidden="true">
          <span class="hp-bus-tick hp-bus-tick--l"></span>
          <span class="hp-bus-tick hp-bus-tick--c"></span>
          <span class="hp-bus-tick hp-bus-tick--r"></span>
          <span class="hp-bus-line"></span>
          <span class="hp-bus-drop"></span>
        </div>

        <div class="hp-core">
          <p class="micro hp-core-label">One CanaryOne layer</p>
          <ul class="hp-core-items">
            <li>shared identity</li>
            <li>company knowledge</li>
            <li>policy and budgets</li>
            <li>the model layer, measured</li>
          </ul>
        </div>

        <div class="hp-drop" aria-hidden="true"></div>

        <div class="hp-dests">
          <p class="micro hp-stack-cap">Whatever runs underneath</p>
          <div class="hp-dest-row">
            <span class="hp-dest">Open-weight models</span>
            <span class="hp-dest">The closed models you already pay for</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── 2. ONE SYSTEM ───
       Three surfaces, one sentence each. Every card opens on "we're building", because COPY.md
       puts the register in the sentence rather than in a badge beside it, and because a visitor
       who reads one card and leaves should still have been told the truth. -->
  <section class="section">
    <div class="container">
      <div class="sec-copy">
        <p class="kicker">ONE SYSTEM</p>
        <h2>AI people can use.<br />Infrastructure the company can control.</h2>
        <p class="lede">
          We&rsquo;re building three surfaces on one shared layer, so a company does not have to
          buy them separately and then make them agree with each other.
        </p>
      </div>

      <div class="hp-cards hp-cards-3">
        <div class="panel hp-card">
          <p class="micro">ASK</p>
          <h3>Chat and company knowledge</h3>
          <p>
            We&rsquo;re building a chat surface that can answer from the company&rsquo;s own
            documents, so an employee gets a useful answer without moving the document somewhere
            else to get one.
          </p>
        </div>
        <div class="panel hp-card">
          <p class="micro">BUILD</p>
          <h3>Coding and API access</h3>
          <p>
            We&rsquo;re building model access for engineers through an OpenAI-compatible API and
            the coding tools they already work in.
          </p>
        </div>
        <div class="panel hp-card">
          <p class="micro">CONTROL</p>
          <h3>One place for the organisation</h3>
          <p>
            We&rsquo;re building one admin surface for people, model access, budgets and the
            audit record, rather than one console per tool.
          </p>
        </div>
      </div>

      <div class="evidence">
        <p class="evidence-note">
          None of the three ships yet. What ships today is the benchmarking tool underneath them,
          which is open source and runs on your own machine.
          {' '}<a href="/evals">See what it does &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ─── 3. THE STACK ───
       The packaging thesis, as the purchase it replaces rather than as a second architecture
       diagram. Six rows, named by category and never by vendor: naming five competitors here
       would turn a packaging argument into a comparison we have not run. -->
  <section class="section">
    <div class="container">
      <div class="sec-copy">
        <p class="kicker">THE STACK</p>
        <h2>One system instead of five vendors.</h2>
        <p class="lede">
          The same identity, the same company knowledge, the same controls and the same model
          layer sit under every surface. That is the whole reason to buy it as one thing.
        </p>
        <p class="claim">
          Assembled the usual way, this is five purchases, five admin consoles and five bills
          that know nothing about each other.
        </p>
      </div>

      <div class="panel hp-swap">
        <div class="hp-swap-side">
          <p class="micro">Assembled yourself</p>
          <ul class="hp-swap-parts">
            <li>a chat tool</li>
            <li>a knowledge search tool</li>
            <li>a coding assistant</li>
            <li>a gateway or router</li>
            <li>an admin, budget and audit console</li>
          </ul>
          <p class="hp-swap-foot">plus the glue between them, which nobody sells</p>
        </div>

        <div class="hp-swap-arrow" aria-hidden="true">&rarr;</div>

        <div class="hp-swap-side">
          <p class="micro">One CanaryOne layer</p>
          <div class="hp-swap-one">
            <ul class="hp-swap-parts hp-swap-parts--in">
              <li>chat, knowledge, coding and API</li>
              <li>one identity across all of them</li>
              <li>one company knowledge index</li>
              <li>one set of budgets, policy and audit</li>
              <li>one measured model layer</li>
            </ul>
          </div>
          <p class="hp-swap-foot">one contract, one console, one bill</p>
        </div>
      </div>

      <div class="evidence">
        <p class="evidence-note">
          We&rsquo;re building this as one product. The column on the right describes what we
          intend to ship, not what a customer can buy today.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── 4. INTELLIGENCE ───
       The bridge between the company we are describing and the machinery that already exists.
       Two modules, and they are different kinds of evidence on purpose: the market half is free
       metadata read several times a day, the workload half is a measured run. The evidence
       footer keeps them apart, because a sentence that mixes them is the specific error
       CLAUDE.md in fantastic-dollop warns about.

       Tinted, so the one section on the page carrying figures reads as its own block. -->
  <section class="section hp-intel">
    <div class="container">
      <div class="sec-copy">
        <p class="kicker">CANARYONE INTELLIGENCE</p>
        <h2>The model layer is measured, not guessed.</h2>
        <p class="lede">
          A shelf of models picked off a public leaderboard is a guess about somebody else&rsquo;s
          workload. We read what the market advertises every day, and we measure what real work
          costs on each route.
        </p>
        <p class="claim">
          Market intelligence tells us where to look. Workload benchmarking tells you what
          actually wins.
        </p>
      </div>

      <div class="hp-cards hp-cards-2">
        <!-- Module A — the market. One model's listed price across every host serving it. -->
        <div class="panel hp-mod">
          <p class="micro">MARKET INTELLIGENCE</p>
          <h3>
            The same model, {mult(spreadModel.price_in.ratio)} the price
            depending on where it runs.
          </h3>
          <p class="hp-mod-sub">
            {spreadModel.short}, as advertised by the companies serving it. Each dot is one host.
          </p>

          <div class="hp-strip">
            <svg viewBox="0 0 400 44" role="img"
                 aria-label={`Listed input price for ${spreadModel.short} across ${spDots.length} hosts, from ${usd(spLo)} to ${usd(spHi)} per million tokens.`}>
              {/* The median, drawn rather than only stated. A strip whose dots cluster at one
                  end and whose copy names a midpoint the picture does not mark reads as two
                  facts about different things — /market's ladder draws its mean for the same
                  reason. */}
              <line class="hp-strip-mid" x1={4 + (spX(spreadModel.price_in.median) / 100) * 392}
                    y1="6" x2={4 + (spX(spreadModel.price_in.median) / 100) * 392} y2="38" />
              <line class="hp-strip-axis" x1="4" y1="22" x2="396" y2="22" />
              {spDots.map((p: number) => (
                <circle class="hp-strip-dot" cx={4 + (spX(p) / 100) * 392} cy="22" r="4" />
              ))}
              {/* The dearest host is the finding, so it is the one mark that takes the ink. */}
              <circle class="hp-strip-dot hp-strip-dot--hi" cx="396" cy="22" r="6" />
            </svg>
            <div class="hp-strip-ends">
              <span>{usd(spLo)} per million</span>
              <span>{usd(spHi)} per million</span>
            </div>
          </div>
          <p class="hp-mod-note">
            The rule marks the middle of the market. Half of the companies serving this model
            charge under {priceWords(spreadModel.price_in.median)} per million tokens.
          </p>

          <p class="hp-mod-src">
            {market.totals.models_published} models &middot;
            {' '}{market.totals.host_endpoints} live endpoints &middot; read several times a day
            <br />Captured {stamp(market.captured_at)}
          </p>
          <p class="hp-mod-link">
            <a href="/market">Explore CanaryOne Market &rarr;</a>
          </p>
        </div>

        <!-- Module B — the workload. Three routes out of one run, lettered. -->
        <div class="panel hp-mod">
          <p class="micro">WORKLOAD BENCHMARKING</p>
          <h3>The cheapest tokens can cost the most per finished task.</h3>
          <p class="hp-mod-sub">
            One workload, one model, {spell(run.totals.lanes)} routes. Three of them below, on
            identical tasks.
          </p>

          <div class="hp-routes-wrap">
          <table class="tm-data-table hp-routes">
            <caption class="sr-only">
              Three of the {run.totals.lanes} routes measured in run {runId}, showing attempts
              finished and cost per finished task.
            </caption>
            <thead>
              <tr>
                <th scope="col">Route</th>
                <th scope="col">Finished</th>
                <th scope="col">Cost per finished task</th>
              </tr>
            </thead>
            <tbody>
              {shown.map((l, i) => (
                <tr>
                  <th scope="row">{LETTERS[i]}</th>
                  <td>{l.passed} of {l.attempted}</td>
                  <td>{usd4(l.costPerPass)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          </div>

          <p class="hp-mod-src">
            {runBar}
            <br />Measured {day(run.startedAt)} &middot;
            {' '}<a href={DEMO_REPORT} target="_blank" rel="noopener">open the full report &rarr;</a>
          </p>
          <p class="hp-mod-link">
            <a href="/evals">Benchmark your workload &rarr;</a>
          </p>
        </div>
      </div>

      <div class="evidence">
        <p class="evidence-note">
          <strong>The two halves are different kinds of evidence.</strong> The market figure is
          what a host advertises, read from listed metadata, and it says nothing about how well
          that host serves the model. The route figures are one measured run of our own tool
          against one repository.
        </p>
        <p class="evidence-caveat">
          The routes are lettered because one local run demonstrates what the measurement
          produces and establishes nothing about a company. The size of a gap like this repeats
          from run to run; which route sits at either end does not.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── 5. MIGRATION ───
       Control first, migrate second. The closed-model providers are named as a fact about what a
       customer already pays for, never in judgement — COPY.md § Naming a host bans the second,
       not the first. -->
  <section class="section">
    <div class="container">
      <div class="sec-copy">
        <p class="kicker">MOVE AT YOUR PACE</p>
        <h2>You do not have to switch everything at once.</h2>
        <p class="lede">
          We plan to sit over the models a company already pays for first, so that control and
          measurement arrive before any migration does. Moving a workload to an open model is
          then one decision per workload, taken when the numbers say so.
        </p>
      </div>

      <div class="hp-flow">
        <div class="hp-stage">
          <p class="micro">Today</p>
          <div class="panel hp-stage-card">
            <ul>
              <li>the OpenAI and Anthropic keys you already pay for</li>
              <li>your existing integrations</li>
              <li>no model change</li>
            </ul>
          </div>
        </div>

        <p class="hp-flow-arrow" aria-hidden="true">&rarr;</p>

        <div class="hp-stage">
          <p class="micro">Through CanaryOne</p>
          <div class="panel hp-stage-card hp-stage-card--mid">
            <ul>
              <li>one identity across every surface</li>
              <li>budgets and policy in one place</li>
              <li>an audit record</li>
              <li>measurement on your own workload</li>
            </ul>
          </div>
        </div>

        <p class="hp-flow-arrow" aria-hidden="true">&rarr;</p>

        <div class="hp-stage">
          <p class="micro">When one wins</p>
          <div class="panel hp-stage-card">
            <ul>
              <li>an open-weight model</li>
              <li>a regional or specialised host</li>
              <li>one workload at a time</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="evidence">
        <p class="evidence-note">
          We plan to work this way. None of the three stages ships today, and nothing here is a
          judgement about the providers a company is already using.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── 6. YOUR COMPANY ───
       Four things a company asks before it lets a tool near its documents. Every one of them is
       intended, so every one of them says so. No connector names and no compliance acronyms: a
       named connector is a "planned support" claim we would then have to keep true, and a
       certification we do not hold is not a design decision, it is a false statement. -->
  <section class="section">
    <div class="container">
      <div class="sec-copy">
        <p class="kicker">YOUR COMPANY</p>
        <h2>Your knowledge. Your region. Your rules.</h2>
        <p class="lede">
          These are the four questions that decide whether a company can use a tool like this at
          all. We plan to answer them in the product rather than in a policy document.
        </p>
      </div>

      <div class="hp-cards hp-cards-4">
        <div class="panel hp-card">
          <h3>Connect your knowledge</h3>
          <p>
            We plan to read from the systems where company information already lives, so people
            can ask about their own documents.
          </p>
        </div>
        <div class="panel hp-card">
          <h3>Carry your permissions</h3>
          <p>
            We plan to carry the identity and the file permissions a company already has through
            the AI layer, rather than creating a second set of them.
          </p>
        </div>
        <div class="panel hp-card">
          <h3>Set policy and spend</h3>
          <p>
            We plan to put model access, spending limits and organisational usage in one place.
          </p>
        </div>
        <div class="panel hp-card">
          <h3>Choose where it runs</h3>
          <p>
            We plan to let a company choose the region and the model infrastructure its own
            workloads run on.
          </p>
        </div>
      </div>

      <div class="evidence">
        <p class="evidence-note">
          Every line in this section is intended rather than built, and we hold no compliance
          certification. What is true today is narrower and worth saying plainly: the
          benchmarking tool runs on your machine, against your own tests, and nothing sits in
          your request path. <a href="/evals">See exactly what leaves &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ─── 7. EVIDENCE ───
       The compact enterprise-depth section, and the one place on the page where shipped and
       planned sit in the same object — so they get a status column rather than a hedge. The
       object is the artefact the measurement layer already produces. -->
  <section class="section">
    <div class="container">
      <div class="sec-copy">
        <p class="kicker">WHEN YOU NEED EVIDENCE</p>
        <h2>Simple for users. Inspectable when it matters.</h2>
        <p class="lede">
          A buyer who has to justify the choice should be able to see the working. The
          measurement layer is the part of this that already exists, and every run it does writes
          an artefact you can open.
        </p>
      </div>

      <div class="panel hp-shot">
        <div class="hp-shot-bar">
          <p class="micro hp-shot-id">{runBar}</p>
          <a href={DEMO_REPORT} target="_blank" rel="noopener">Open example report &rarr;</a>
        </div>
        <div class="hp-shot-body">
          <Image src={viewLeaderboard} widths={[760, 1100, viewLeaderboard.width]}
                 sizes="min(1100px, 88vw)" loading="lazy" class="hp-shot-img"
                 alt="A CanaryOne report: one row per route, with attempts finished, cost per finished task, judge score and latency percentiles beside each other." />
        </div>
      </div>

      <dl class="hp-proof">
        <div>
          <dt>Workload benchmarking</dt>
          <dd class="hp-proof-when">Today</dd>
          <dd>Run it on your own repository and get one row per route.</dd>
        </div>
        <div>
          <dt>Route and model evidence</dt>
          <dd class="hp-proof-when">Today</dd>
          <dd>Every figure on this site carries its date and links to the run behind it.</dd>
        </div>
        <div>
          <dt>Audit and policy record</dt>
          <dd class="hp-proof-when">Planned</dd>
          <dd>Part of the admin surface we&rsquo;re building.</dd>
        </div>
        <div>
          <dt>Regional and host choice</dt>
          <dd class="hp-proof-when">Planned</dd>
          <dd>Part of the model layer we&rsquo;re building.</dd>
        </div>
      </dl>

      <div class="evidence">
        <p class="evidence-src">
          The report is one static file, written to
          {' '}<code>&lt;repo&gt;/.c1/runs/&lt;runId&gt;/report/index.html</code>, so it opens
          from disk and travels in a pull request.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── 8. CLOSE ───
       One button and one link. .btn.ghost is a dark-surface component, so the second action here
       is a text link rather than a second button. -->
  <section class="section hp-close">
    <div class="container">
      <div class="hp-close-inner">
        <h2>Stop assembling your AI stack.</h2>
        <p class="lede">
          Start with the models and the tools you already use. We&rsquo;re building one place for
