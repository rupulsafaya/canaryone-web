        </p>
        <div class="hp-close-ctas">
          <a class="btn primary" href="#waitlist">Get early access &rarr;</a>
          <a class="hp-close-alt" href="/evals">Benchmark your workload &rarr;</a>
        </div>
        <p class="hp-close-links">
          <a href="/market">Market</a> &middot;
          <a href="/evals">Benchmarking</a> &middot;
          <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Only what global.css has no equivalent for. The section shell, the buttons, the table, the
     panel surface, the evidence footer and every label on this page are existing primitives.
     Scoped rather than global: the live index.astro publishes its hero layout with
     `is:global`, and two home pages fighting over `.hero__inner` is a promotion-day bug. */

  /* ---- hero ---- */
  /* The copy holds the lede measure; the diagram below it runs the full container. */
  .hp-hero-copy { max-width: var(--measure-lede); }
  .hp-trust {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted-on-dark);
    margin: var(--space-6) 0 0;
  }

  /* ---- the hero diagram ----
     Many needs at the top, one layer in the middle, many models underneath. HTML and CSS, for
     the reason /evals builds its fan-out the same way: the only geometry is a few hairlines,
     and a grid reflows on a phone where an 800-unit viewBox needs a sideways swipe. */
  .hp-stack { margin-top: clamp(48px, 7vw, 88px); }
  .hp-stack-cap { text-align: center; }
  .hp-surfaces {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }
  /* One step darker than the band, which is what --dark-deep is for: a surface sitting on top
     of a dark panel. */
  .hp-surface {
    background: var(--dark-deep);
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-dark);
    padding: var(--space-5) var(--space-5) var(--space-6);
    text-align: center;
  }
  .hp-surface-name {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--text-on-dark);
    margin: 0 0 var(--space-2);
  }
  .hp-surface-sub {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    color: var(--muted-on-dark);
    margin: 0;
  }

  /* The three surfaces converging on one layer. Percentages rather than lengths, because each
     tick has to land on the centre of its own column whatever the container is doing. */
  .hp-bus { position: relative; height: var(--space-10); }
  .hp-bus-tick,
  .hp-bus-line,
  .hp-bus-drop {
    position: absolute;
    background: var(--line-dark);
  }
  .hp-bus-tick { top: 0; height: 50%; width: 1px; }
  .hp-bus-tick--l { left: 16.667%; }
  .hp-bus-tick--c { left: 50%; }
  .hp-bus-tick--r { left: 83.333%; }
  .hp-bus-line { top: 50%; left: 16.667%; right: 16.667%; height: 1px; }
  .hp-bus-drop { top: 50%; bottom: 0; left: 50%; width: 1px; }

  /* The one yellow in the diagram, and it is a hairline and a wash on a dark surface — which is
     the only place either is legible, hence the -on-dark suffix on both tokens. */
  .hp-core {
    border: 1px solid var(--accent-line-on-dark);
    background: var(--accent-bg-on-dark);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6) var(--space-6);
    text-align: center;
  }
  .hp-core-label { color: var(--accent-deep); }
  .hp-core-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-on-dark);
  }

  .hp-drop {
    width: 1px;
    height: var(--space-10);
    background: var(--line-dark);
    margin: 0 auto;
  }

  .hp-dests { text-align: center; }
  .hp-dest-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
  .hp-dest {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted-on-dark);
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
  }

  /* ---- card grids ----
     One card component at three widths. .panel carries the section's copy-to-object gap in its
     own top margin, which is wrong inside a grid — the grid owns the gap. */
  .hp-cards {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-12);
  }
  .hp-cards-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .hp-cards-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .hp-cards-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .hp-cards > .panel { margin-top: 0; }
  .hp-card { padding: var(--space-8) var(--space-7); }
  .hp-card h3 {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-3);
  }
  .hp-card p:last-child {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--muted);
    margin: 0;
  }

  /* ---- 3. the stack: five parts against one ----
     The picture is the count. Five separate bordered rows on the left, one bordered block on the
     right, at the same width — nothing else has to be said for the contrast to land. */
  .hp-swap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-8) var(--space-7);
  }
  .hp-swap-parts { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .hp-swap-parts > li {
