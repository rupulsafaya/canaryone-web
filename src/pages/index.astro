    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }

  /* Four proof points, with the status in a column of its own rather than hedged into the
     sentence beside it. */
  .hp-proof { margin: var(--space-8) 0 0; display: grid; gap: var(--space-3); }
  .hp-proof > div {
    display: grid;
    grid-template-columns: minmax(0, var(--col-label)) auto minmax(0, 1fr);
    gap: var(--space-4);
