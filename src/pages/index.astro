  .hp-stage { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .hp-stage-card {
    margin-top: 0;
    flex: 1;
    padding: var(--space-5);
  }
  /* The middle stage is us, so it carries the weight the two ends do not. */
  .hp-stage-card--mid { border-color: var(--line-strong); box-shadow: var(--shadow-sm); }
  .hp-stage-card ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .hp-stage-card li {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--muted);
  }
  .hp-stage-card--mid li { color: var(--text); }
  /* Ornament inside a diagram, which is where COPY.md allows an arrow a row of its own. */
  .hp-flow-arrow {
    align-self: center;
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--muted);
