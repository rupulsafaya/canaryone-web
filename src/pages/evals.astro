    margin: 0 0 var(--space-5);
  }
  /* The crop fills the panel. The three sources are twice their display width, so the narrowest
     of them still renders above one-to-one. */
  .ev-view-img {
    display: block;
    width: 100%;
    min-width: var(--chart-min);
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }

  /* ---- 5. what leaves ---- */
  /* Inside the machine is a surface; outside it is the page. That is the whole diagram, and the
     panel's own border is the boundary. */
  .ev-machine { margin-top: var(--space-12); }
  /* Tightened by about an eighth once the diagram was legible enough not to need the room: the
     panel gives back a step of padding top and bottom, the nodes a step of their own, and the
     connector above the crossing a third of its length. The top padding still has to clear the
     label straddling the border. */
  .ev-inside {
    position: relative;
    margin-top: 0;
    background: var(--bg-tint);
    border-color: var(--line-strong);
    padding: var(--space-8) var(--space-6) var(--space-5);
  }
  /* The boundary's label, straddling its top edge the way .boundary does on the live page. */
  .ev-inside-label {
    position: absolute;
    top: calc(-1 * var(--space-3));
    left: var(--space-6);
    margin: 0;
    background: var(--bg);
    padding: 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--muted);
  }
  .ev-chain {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: var(--space-3);
  }
  .ev-node {
    flex: 1 1 0;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
  }
  .ev-node-name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
    margin: 0;
  }
  .ev-node-sub {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--muted);
    margin: var(--space-1) 0 0;
  }
  .ev-chain-arrow {
    align-self: center;
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--muted);
    flex: 0 0 auto;
  }

  /* The crossing, which is the story. A connector down from the boundary with the label on it.
     THE PILL IS THE ONLY YELLOW IN THE SECTION and it is a fill behind dark text, not a
     coloured line: --accent-deep on cream measures 1.87:1, so a yellow rule that has to be seen
     is out, and a yellow chip carrying dark text is in. */
  .ev-cross {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }
  .ev-cross::before,
  .ev-cross::after {
    content: "";
    width: 1px;
    height: var(--space-4);
    background: var(--line-strong);
  }
  .ev-cross-pill {
    background: var(--accent);
    color: var(--dark);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-4);
  }

  .ev-outside { text-align: center; }
  .ev-outside-label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--space-3);
  }
  /* Three destinations, each one what leaves and where it goes. A list rather than a slab,
     because "the judge is optional" was the thing a reader most needed to see and it was
     buried mid-sentence in the middle of one. */
  .ev-egress {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    text-align: left;
    max-width: var(--panel-max);
    margin-inline: auto;
  }
  .ev-egress > div {
    display: grid;
    grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--line);
  }
  .ev-egress > div:last-child { border-bottom: 0; padding-bottom: 0; }
  .ev-egress dt, .ev-egress dd { margin: 0; font-size: var(--text-sm); }
  .ev-egress dt { font-family: var(--font-mono); color: var(--text); }
  .ev-egress dd { color: var(--muted); }
  .ev-egress code {
    font-family: var(--font-mono);
    background: var(--bg-tint);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: var(--space-0-5) var(--space-1);
  }

  /* Three small facts, not three cards. The tick is ornament inside a label, which is where a
     glyph is allowed to stand on its own. */
  .ev-badges {
    list-style: none;
    margin: var(--space-10) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-8);
  }
  .ev-badges li {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
  }
  .ev-badges li::before {
    content: "✓";
    color: var(--muted);
    margin-right: var(--space-2);
  }

  /* ---- 6. coverage ---- */
  /* The breadth, up front, so nobody has to count marks to find it. */
  .ev-stat {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-variant-numeric: tabular-nums;
    color: var(--text);
    margin: var(--space-4) 0 var(--space-5);
  }
  .ev-cov-row { margin-top: var(--space-6); }
  .ev-cov-label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--space-2);
  }
  /* A fixed grid, not a wrapping row of pills. Every cell is the same width and the same height
     whatever its name is; the previous version sized each pill to its own content, which turned
     one list into two ragged rows and read as a bag of logos. */
  /* A fixed grid, not a wrapping row of pills sized to their own names. Five columns for the
     fourteen providers, which lands them in three rows; three for the routers. The gap is half
     what it was and the cell is little more than the height of one line of type, because a
     coverage row is a list rather than an exhibit and the section it sat in was the tallest on
     the page for the least content. */
  .ev-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .ev-grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .ev-grid-5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  /* .ev-obj gives the cell its surface, so a cell and a panel share one border and one radius.
     Its top margin is the section's copy-to-object gap and is wrong inside a grid. */
  .ev-cell {
    margin-top: 0;
    min-height: var(--space-16);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
  }
  /* --logo-h rather than --logo-icon: at 32px the mark was the tallest thing in the cell and set
     its height. These are square marks beside one line of type, so they want the wordmark
     height, not the hero glyph size. */
  .ev-cell-mark {
    width: var(--logo-h);
    height: var(--logo-h);
    display: block;
    flex: 0 0 auto;
  }
  /* One line, always. A name that cannot fit its cell is a shorter name rather than a taller
     grid — see cellName() for the one case that needed shortening. */
  .ev-cell-name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* The closing line, which is deliberately not a footer: no rule above it and no label. */
  .ev-cov-note { margin-top: var(--space-6); }

  /* LAST IN THE BLOCK, because these override base rules of equal specificity and source
     order decides. An @media placed above them does nothing at all. */
  @media (max-width: 900px) {
    /* The hero's three panels stack and its arrows turn to point down. The arrow is a grid item
       between two stages, so it stays between them once the columns collapse to one. */
    .ev-flow { grid-template-columns: 1fr; gap: var(--space-5); }
    .ev-arrow { margin: 0; text-align: center; transform: rotate(90deg); }
    .ev-steps { grid-template-columns: 1fr; gap: var(--space-6); }
    /* The machine's chain goes vertical, and its arrows turn with it. */
    .ev-chain { flex-direction: column; }
    .ev-chain-arrow { transform: rotate(90deg); }
    /* Five columns is too tight for a mark and a name once the container narrows. */
    .ev-grid-5 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .ev-claim { font-size: var(--text-lg); }
    /* A percentage first column stops working once the labels are the taller half of the
       table, and the value columns need the width more than the label does. */
    .ev-compare th[scope='row'] { width: auto; }
    /* One column, not two. Two columns on a 375px phone leaves about 90px for the name, and
       "Vercel AI Gateway", "Moonshot Intl", "Fireworks AI" and "Google Gemini" all ellipsised —
       a truncated company name reads as a broken row rather than a tight one. */
    .ev-grid-3,
    .ev-grid-5 { grid-template-columns: 1fr; }
    /* The destination and its label stack rather than sharing a fixed first column. */
    .ev-egress > div { grid-template-columns: 1fr; gap: var(--space-1); }
    .ev-badges { gap: var(--space-2); }
  }
</style>

<!-- One rule set per report view, pairing radio N with chip N and card N. Generated because the
     count is data-driven, and injected globally because Astro's scoped styles cannot carry a
     generated block. Every selector is under .ev-sel, which exists only on this page. -->
<style is:global set:html={viewCss}></style>
