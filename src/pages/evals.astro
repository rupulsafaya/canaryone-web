    margin: var(--space-5) 0 0;
  }

  /* The fan-out. Three panels and two arrows on one row, and it is HTML rather than SVG for
     the reason /market's experiment card is: the only geometry is a couple of rules, and a
     grid reflows on a phone where an 800-unit viewBox needs a sideways swipe. */
  .ev-flow {
    display: grid;
