---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { KIND_LABEL, KIND_WEIGHT, formatDate } from '../../lib/runs';

export async function getStaticPaths() {
  const runs = await getCollection('runs');
  return runs.map((run) => ({ params: { slug: run.id }, props: { run } }));
}

const { run } = Astro.props;
const { Content, headings } = await render(run);
const { date, title, summary, kind, routes, spend, sourceFile } = run.data;

const sections = headings.filter((h) => h.depth === 2);

/**
 * A run page earns the right to be cited by carrying its own limits. If the source file
 * lost that section, say so at build time rather than publishing a page that reads as an
 * unqualified result.
 */
const CAVEAT_HEADING = /does not support|cannot be published|not publishable/i;
if (!sections.some((s) => CAVEAT_HEADING.test(s.text))) {
  console.warn(
    `[runs] ${run.id} has no "what this run does not support" section. ` +
      `Add one in ${sourceFile} and re-run pnpm import:runs.`
  );
}
---

<Layout
  title={`${title} — CanaryOne run report`}
  description={summary}
  path={`/runs/${run.id}/`}
>
  <div class="page-band">
    <div class="run-head">
      <div class="container narrow">
        <p class="crumb"><a href="/runs">runs</a> / {date}</p>
        <h1>{title}</h1>
        <p class="summary">{summary}</p>
      </div>
    </div>
  </div>

  <article class="run">
    <div class="container narrow">
      <dl class="identity">
        <div>
          <dt>Run date</dt>
          <dd><time datetime={date}>{formatDate(date)}</time></dd>
        </div>
        <div>
          <dt>Kind of run</dt>
          <dd>{KIND_LABEL[kind]}</dd>
        </div>
        {routes && (
          <div>
            <dt>Route matrix</dt>
            <dd>{routes}</dd>
          </div>
        )}
        {spend && (
          <div>
            <dt>Total spend</dt>
            <dd>{spend}</dd>
          </div>
        )}
      </dl>

      <div class="status-note">
        <p>
          <span class="label">How much this run carries</span>
          {KIND_WEIGHT[kind]}
        </p>
      </div>

      {sections.length > 0 && (
        <nav class="jump" aria-label="Sections of this report">
          <p class="label">In this report</p>
          <ul>
            {sections.map((s) => (
              <li><a href={`#${s.slug}`}>{s.text}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <div class="prose">
        <Content />
      </div>

      <p class="provenance">
        This page is a published copy. The source of truth is
        <code>{sourceFile}</code> in the fantastic-dollop repository, and it is copied
        here by <code>scripts/import-runs.mjs</code> rather than edited in place.
      </p>
    </div>
  </article>
</Layout>
