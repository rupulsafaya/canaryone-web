---
import Layout from '../../layouts/Layout.astro';
import RunCard from '../../components/RunCard.astro';
import { getRuns } from '../../lib/runs';

const runs = await getRuns();
---

<Layout
  title="Run reports — CanaryOne"
  description="Every benchmark run we have published, with its method, its route matrix and an explicit note on what it does not support."
  path="/runs/"
>
  <header class="page-head">
    <div class="container">
      <h1>Run reports</h1>
      <p class="lede">
        Every run we have published, newest first. Each one carries its method, its
        route matrix, what was held constant, and an explicit note on what it does not
        support — because a table without its method is not usable, and a result without
        its limits is marketing.
      </p>
    </div>
  </header>

  <section class="runs-list">
    <div class="container">
      <div class="run-cards">
        {runs.map((run) => <RunCard run={run} showFacts headingLevel="h2" />)}
      </div>
    </div>
  </section>
</Layout>
